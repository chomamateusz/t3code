+  menu: LinkedQuestionsMenu,
+  resolve: MessageResolver = m,
+): ReadonlyArray<{
+  readonly choice: LinkedQuestionsMenuChoice;
+  readonly label: string;
+  readonly checked: boolean;
+}> {
+  const from = menu.inherited.from === "project" ? "project" : "machine";
+  return [
+    {
+      choice: "default",
+      label: resolve(LINKED_QUESTIONS_DEFAULT_LABELS[from][menu.inherited.answers ? "on" : "off"]),
+      checked: menu.choice === null,
+    },
+    {
+      choice: "on",
+      label: resolve(msg("On", { $context: "answer linked questions" })),
+      checked: menu.choice === "on",
+    },
+    {
+      choice: "off",
+      label: resolve(msg("Off", { $context: "answer linked questions" })),
+      checked: menu.choice === "off",
+    },
+  ];
+}
