+import {
+  type OrchestrationV2AppThread,
+  type ThreadId,
+  threadLinkedQuestionsChoice,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+
+type LinkedQuestionsChoiceThread = Pick<
+  OrchestrationV2AppThread,
+  "id" | "lineage" | "linkedQuestionsEnabledAt" | "linkedQuestionsDisabledAt"
+>;
+
+const hasNoLinkedQuestionsMenu = (thread: LinkedQuestionsChoiceThread) =>
+  thread.lineage.relationshipToParent === "subagent" || thread.lineage.sideChat === true;
+
+/**
+ * A side chat or subagent has no menu of its own, so it is Off while the nearest thread above it
+ * that has one is Off now. An Off stored on it by an older build or client still counts.
+ */
+export const isLinkedQuestionsOff = Effect.fn("linkedQuestions.isLinkedQuestionsOff")(function* <
+  Thread extends LinkedQuestionsChoiceThread,
+  E,
+>(findThread: (threadId: ThreadId) => Effect.Effect<Thread | null, E>, thread: Thread) {
+  const seen = new Set<ThreadId>();
+  let current: Thread | null = thread;
+  while (current !== null && !seen.has(current.id)) {
+    if (threadLinkedQuestionsChoice(current) === "off") return true;
+    const parentThreadId: ThreadId | null = current.lineage.parentThreadId;
+    if (!hasNoLinkedQuestionsMenu(current) || parentThreadId === null) return false;
+    seen.add(current.id);
+    current = yield* findThread(parentThreadId);
+  }
+  return false;
+});
+
+/**
+ * Builds without linked question levels drop linkedQuestionsDisabledAt when they rewrite a thread
+ * and wrote this receipt without its choice. The choice in the receipt type survives them.
+ */
+export const LINKED_QUESTIONS_SET_RECEIPT_TYPES = {
+  previousBuild: "thread.linked-questions.set",
+  on: "thread.linked-questions.set:on",
+  off: "thread.linked-questions.set:off",
+  default: "thread.linked-questions.set:default",
+} as const;
+
+export const linkedQuestionsSetReceiptType = (enabled: boolean | null) =>
+  LINKED_QUESTIONS_SET_RECEIPT_TYPES[enabled === null ? "default" : enabled ? "on" : "off"];
