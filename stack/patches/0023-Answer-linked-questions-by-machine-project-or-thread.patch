diff --git a/packages/contracts/src/linkedQuestions.test.ts b/packages/contracts/src/linkedQuestions.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0c74ec94eaf9b24892f0030d2fb6eac1d96def8d
--- /dev/null
+++ b/packages/contracts/src/linkedQuestions.test.ts
@@ -0,0 +1,101 @@
+import { describe, expect, it } from "vite-plus/test";
+import * as Schema from "effect/Schema";
+
+import {
+  type LinkedQuestionsChoice,
+  type LinkedQuestionsThread,
+  resolveLinkedQuestions,
+  threadAnswersLinkedQuestions,
+  threadLinkedQuestionsChoice,
+} from "./linkedQuestions.ts";
+import { PROJECT_SCOPED_SERVER_SETTING_KEYS, ProjectSettingsOverrides } from "./settings.ts";
+import { T3ProjectFile } from "./t3ProjectFile.ts";
+
+const decodeProjectFile = Schema.decodeUnknownSync(T3ProjectFile);
+const decodeProjectSettings = Schema.decodeUnknownSync(ProjectSettingsOverrides);
+const lineage = { relationshipToParent: null };
+const kinds: ReadonlyArray<readonly [string, LinkedQuestionsThread, boolean]> = [
+  ["a thread", { lineage }, true],
+  ["a fork", { lineage: { relationshipToParent: "fork" } }, true],
+  ["a question thread", { lineage, linkedQuestionOf: "thread:asked" }, false],
+  ["a subagent", { lineage: { relationshipToParent: "subagent" } }, false],
+  ["a side chat", { lineage: { relationshipToParent: "fork", sideChat: true } }, false],
+  [
+    "a workflow's agent step",
+    { lineage: { relationshipToParent: null, workflowStep: true } },
+    false,
+  ],
+];
+const stored = (thread: LinkedQuestionsChoice | null) =>
+  thread === "on"
+    ? { linkedQuestionsEnabledAt: "2026-11-24T00:00:00.000Z" }
+    : thread === "off"
+      ? { linkedQuestionsDisabledAt: "2026-11-24T00:00:00.000Z" }
+      : {};
+
+describe("threadAnswersLinkedQuestions", () => {
+  it.each([
+    [false, null, null, false],
+    [false, null, "on", true],
+    [false, null, "off", false],
+    [false, "on", null, true],
+    [false, "on", "on", true],
+    [false, "on", "off", false],
+    [false, "off", null, false],
+    [false, "off", "on", true],
+    [false, "off", "off", false],
+    [true, null, null, true],
+    [true, null, "on", true],
+    [true, null, "off", false],
+    [true, "on", null, true],
+    [true, "on", "on", true],
+    [true, "on", "off", false],
+    [true, "off", null, false],
+    [true, "off", "on", true],
+    [true, "off", "off", false],
+  ] as const)(
+    "machine %s, project %s, thread %s: answers %s, except threads that never answer",
+    (machine, project, thread, expected) => {
+      for (const [kind, shape, takesQuestions] of kinds) {
+        expect(
+          threadAnswersLinkedQuestions({
+            thread: { ...shape, ...stored(thread) },
+            project,
+            machine,
+          }),
+          kind,
+        ).toBe(takesQuestions && expected);
+      }
+    },
+  );
+
+  it("names the level the answer comes from", () => {
+    expect(resolveLinkedQuestions({ thread: "off", project: "on", machine: true })).toEqual({
+      answers: false,
+      from: "thread",
+    });
+    expect(resolveLinkedQuestions({ thread: null, project: "on", machine: false })).toEqual({
+      answers: true,
+      from: "project",
+    });
+    expect(resolveLinkedQuestions({ thread: null, project: null, machine: true })).toEqual({
+      answers: true,
+      from: "machine",
+    });
+  });
+
+  it("reads a thread stored as on as on, and any other stored thread as not set", () => {
+    expect(threadLinkedQuestionsChoice({ linkedQuestionsEnabledAt: "2026-11-23T00:00:00Z" })).toBe(
+      "on",
+    );
+    expect(threadLinkedQuestionsChoice({ linkedQuestionsEnabledAt: null })).toBeNull();
+    expect(threadLinkedQuestionsChoice({})).toBeNull();
+  });
+
+  it("is never carried by a project file or by project settings", () => {
+    const carried = { linkedQuestions: "on", linkedQuestionsAnswerByDefault: true };
+    expect(decodeProjectFile(carried)).toEqual({});
+    expect(decodeProjectSettings(carried)).toEqual({});
+    expect(PROJECT_SCOPED_SERVER_SETTING_KEYS).not.toContain("linkedQuestionsAnswerByDefault");
+  });
+});
diff --git a/packages/contracts/src/linkedQuestions.ts b/packages/contracts/src/linkedQuestions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4124ac38b4d9fec8775c89165d527a7d69be068c
--- /dev/null
+++ b/packages/contracts/src/linkedQuestions.ts
@@ -0,0 +1,101 @@
+import * as Schema from "effect/Schema";
+
+import type { OrchestrationV2AppThreadLineage } from "./orchestrationV2.ts";
+
+export const LinkedQuestionsChoice = Schema.Literals(["on", "off"]);
+export type LinkedQuestionsChoice = typeof LinkedQuestionsChoice.Type;
+
+export type LinkedQuestionsLevel = "thread" | "project" | "machine";
+
+export interface LinkedQuestionsLevels {
+  readonly thread: LinkedQuestionsChoice | null;
+  readonly project: LinkedQuestionsChoice | null;
+  readonly machine: boolean;
+}
+
+export interface ResolvedLinkedQuestions {
+  readonly answers: boolean;
+  readonly from: LinkedQuestionsLevel;
+}
+
+export function resolveLinkedQuestions(levels: LinkedQuestionsLevels): ResolvedLinkedQuestions {
+  if (levels.thread !== null) return { answers: levels.thread === "on", from: "thread" };
+  if (levels.project !== null) return { answers: levels.project === "on", from: "project" };
+  return { answers: levels.machine, from: "machine" };
+}
+
+export function threadLinkedQuestionsChoice(thread: {
+  readonly linkedQuestionsEnabledAt?: unknown;
+  readonly linkedQuestionsDisabledAt?: unknown;
+}): LinkedQuestionsChoice | null {
+  if (thread.linkedQuestionsEnabledAt != null) return "on";
+  return thread.linkedQuestionsDisabledAt != null ? "off" : null;
+}
+
+export interface LinkedQuestionsThread {
+  readonly lineage: Pick<
+    OrchestrationV2AppThreadLineage,
+    "relationshipToParent" | "sideChat" | "workflowStep"
+  >;
+  readonly linkedQuestionOf?: unknown;
+  readonly linkedQuestionsEnabledAt?: unknown;
+  readonly linkedQuestionsDisabledAt?: unknown;
+}
+
+// The lineage half is isListedThreadLineage, which an import here would make a cycle: a thread
+// the owner has no list row and no menu for never answers.
+const canAnswerLinkedQuestions = (thread: LinkedQuestionsThread): boolean =>
+  thread.linkedQuestionOf == null &&
+  thread.lineage.relationshipToParent !== "subagent" &&
+  thread.lineage.sideChat !== true &&
+  thread.lineage.workflowStep !== true;
+
+export function threadAnswersLinkedQuestions(input: {
+  readonly thread: LinkedQuestionsThread;
+  readonly project: LinkedQuestionsChoice | null;
+  readonly machine: boolean;
+}): boolean {
+  return (
+    canAnswerLinkedQuestions(input.thread) &&
+    resolveLinkedQuestions({
+      thread: threadLinkedQuestionsChoice(input.thread),
+      project: input.project,
+      machine: input.machine,
+    }).answers
+  );
+}
+
+export type LinkedQuestionsControl =
+  | {
+      readonly kind: "levels";
+      readonly choice: LinkedQuestionsChoice | null;
+      readonly inherited: ResolvedLinkedQuestions;
+    }
+  | { readonly kind: "switch"; readonly enabled: boolean };
+
+/**
+ * Null for threads that never answer. A server without `linkedQuestionLevels` takes only on and
+ * off for a thread, so it gets the switch it had.
+ */
+export function threadLinkedQuestionsControl(input: {
+  readonly thread: LinkedQuestionsThread;
+  readonly project: LinkedQuestionsChoice | null;
+  readonly machine: boolean;
+  readonly levels: boolean;
+}): LinkedQuestionsControl | null {
+  if (!input.levels) {
+    return input.thread.linkedQuestionOf == null
+      ? { kind: "switch", enabled: input.thread.linkedQuestionsEnabledAt != null }
+      : null;
+  }
+  if (!canAnswerLinkedQuestions(input.thread)) return null;
+  return {
+    kind: "levels",
+    choice: threadLinkedQuestionsChoice(input.thread),
+    inherited: resolveLinkedQuestions({
+      thread: null,
+      project: input.project,
+      machine: input.machine,
+    }),
+  };
+}
