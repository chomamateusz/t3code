+    lastVisitedAt: resolveThreadLastVisitedAt(
+      thread.lastVisitedAt,
+      useUiStateStore.getState().threadLastVisitedAtById[scopedThreadKey(target)],
+    ),
+    wokeAt: threadWokeAt(thread, { now: new Date().toISOString() }),
+  });
+}
