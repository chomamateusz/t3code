     allowsPlaintext: (url: URL) => allowed.has(hostOf(url)),
-    layerClient: NodeHttpClient.layerUndiciOptions({ connect: { lookup } }),
+    layerClient: NodeHttpClient.layerNodeHttpOptions({ lookup }),
