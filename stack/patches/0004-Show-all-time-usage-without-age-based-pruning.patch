@@ -0,0 +1,44 @@
+// @effect-diagnostics globalDate:off -- A fixed instant keeps calendar-window assertions deterministic.
+import { UsageDay } from "@t3tools/contracts";
+import { describe, expect, it, vi } from "vite-plus/test";
+
+import { makeUsageWindow, usageChartDays } from "./usageRange";
+
+describe("all-time usage range", () => {
+  it("requests daily usage from the fixed early day through today", () => {
+    vi.stubEnv("TZ", "UTC");
+    try {
+      expect(makeUsageWindow("all", new Date("2026-10-03T12:00:00Z"))).toEqual({
+        sinceDay: "1970-01-01",
+        untilDay: "2026-10-03",
+        timeZone: "UTC",
+        resolution: "day",
+      });
+    } finally {
+      vi.unstubAllEnvs();
+    }
+  });
+
+  it("starts the all-time chart on its earliest day with data", () => {
+    expect(
+      usageChartDays(
+        { sinceDay: UsageDay.make("1970-01-01"), untilDay: UsageDay.make("2026-01-05") },
+        [{ day: "2026-01-03" }, { day: "2026-01-02" }],
+      ),
+    ).toEqual(["2026-01-02", "2026-01-03", "2026-01-04", "2026-01-05"]);
+    expect(
+      usageChartDays(
+        { sinceDay: UsageDay.make("1970-01-01"), untilDay: UsageDay.make("2026-01-05") },
+        [],
+      ),
+    ).toEqual(["2026-01-05"]);
+  });
+  it("keeps the full finite displayed window while another range loads", () => {
+    expect(
+      usageChartDays(
+        { sinceDay: UsageDay.make("2026-01-01"), untilDay: UsageDay.make("2026-01-03") },
+        [{ day: "2026-01-03" }],
+      ),
+    ).toEqual(["2026-01-01", "2026-01-02", "2026-01-03"]);
+  });
+});
diff --git a/apps/web/src/components/usage/usageRange.ts b/apps/web/src/components/usage/usageRange.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7401e43c650cdff626866c69a57c0e8eee58cf31
--- /dev/null
+++ b/apps/web/src/components/usage/usageRange.ts
@@ -0,0 +1,26 @@
+import { UsageDay, type UsageSummaryInput } from "@t3tools/contracts";
+import { enumerateDays, makeWindow } from "@t3tools/shared/usageFormat";
+
+export type UsageRange = 1 | 7 | 30 | 90 | "all";
+
+export const ALL_USAGE_SINCE_DAY = UsageDay.make("1970-01-01");
+
+export function makeUsageWindow(range: UsageRange, now = new Date()): UsageSummaryInput {
+  const window = makeWindow(range === "all" ? 1 : range, now, range === 1 ? "hour" : "day");
+  return range === "all" ? { ...window, sinceDay: ALL_USAGE_SINCE_DAY } : window;
+}
+
+export function usageChartDays(
+  window: Pick<UsageSummaryInput, "sinceDay" | "untilDay">,
+  daily: readonly { readonly day: string }[],
+): readonly string[] {
+  const sinceDay =
+    window.sinceDay === ALL_USAGE_SINCE_DAY
+      ? (daily.reduce<string | undefined>(
+          (earliest, entry) =>
+            earliest === undefined || entry.day < earliest ? entry.day : earliest,
+          undefined,
+        ) ?? window.untilDay)
+      : window.sinceDay;
+  return enumerateDays(sinceDay, window.untilDay);
+}
