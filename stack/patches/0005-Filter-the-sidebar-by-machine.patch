+      idsOf(filterSidebarV2VisibleThreads(threads, null, new Set(), selectedMachines)),
+    ).toEqual(["shared-on-remote", "linux-only"]);
+    expect(filterSidebarEnvironmentIds(environmentIds, sharedKeys, selectedMachines)).toEqual([
