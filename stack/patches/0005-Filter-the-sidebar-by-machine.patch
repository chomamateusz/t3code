+      remoteMacId,
+      macbookId,
+    ]);
+    expect(filterSidebarEnvironmentIds(environmentIds, null, new Set([linuxId]))).toEqual([
+      linuxId,
+    ]);
+    expect(filterSidebarEnvironmentIds(environmentIds, new Set(), null)).toEqual([]);
+    const selectedMachines = new Set([remoteMacId, linuxId]);
