+[data-machine-row="root"] {
+  min-width: 0;
+  margin-top: 2px;
+  padding-inline: 8px;
+}
+
+[data-machine-row="trigger"] {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  width: 100%;
+  min-width: 0;
+  height: 28px;
+  padding-inline: 6px;
+  border: 0;
+  border-radius: 7px;
+  background: none;
+  color: var(--sidebar-muted-foreground);
+  font-size: 12px;
+  cursor: pointer;
+}
+
+[data-machine-row="trigger"]:hover,
+[data-machine-row="trigger"][data-popup-open] {
+  background: var(--sidebar-row-hover);
+  color: var(--sidebar-foreground);
