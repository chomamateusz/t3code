diff --git a/apps/web/src/components/sidebar/SidebarMachineRow.css b/apps/web/src/components/sidebar/SidebarMachineRow.css
new file mode 100644
index 0000000000000000000000000000000000000000..956e0322f6de4ae4dc87b1c19e7d2bd8a556ada4
--- /dev/null
+++ b/apps/web/src/components/sidebar/SidebarMachineRow.css
@@ -0,0 +1,41 @@
+[data-machine-row="root"] {
+  min-width: 0;
+  margin-top: 2px;
+  padding-inline: 8px;
+}
+
+[data-machine-row="trigger"] {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  width: 100%;
+  min-width: 0;
+  height: 28px;
+  padding-inline: 6px;
+  border: 0;
+  border-radius: 7px;
+  background: none;
+  color: var(--sidebar-muted-foreground);
+  font-size: 12px;
+  cursor: pointer;
+}
+
+[data-machine-row="trigger"]:hover,
+[data-machine-row="trigger"][data-popup-open] {
+  background: var(--sidebar-row-hover);
+  color: var(--sidebar-foreground);
+}
+
+[data-machine-row="trigger"]:focus-visible {
+  outline: 2px solid var(--ring);
+  outline-offset: 1px;
+}
+
+[data-machine-row="label"] {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  text-align: start;
+}
diff --git a/apps/web/src/components/sidebar/SidebarMachineRow.tsx b/apps/web/src/components/sidebar/SidebarMachineRow.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4a1fe4ab71201d857c5678e7e0dc533539bbd0a9
--- /dev/null
+++ b/apps/web/src/components/sidebar/SidebarMachineRow.tsx
@@ -0,0 +1,128 @@
+import type { EnvironmentId, EnvironmentMachineKind } from "@t3tools/contracts";
+import { T, useGT, useMessages } from "gt-react";
+import { ChevronDownIcon, MonitorSmartphoneIcon } from "lucide-react";
+import { useState } from "react";
+
+import { isMacPlatform } from "../../lib/utils";
+import {
+  buildSidebarEnvironmentScopeItems,
+  nextSidebarEnvironmentScopeKeys,
+} from "../../sidebarEnvironmentScope";
+import { EnvironmentMachineIcon } from "../EnvironmentMachineIcon";
+import {
+  Menu,
+  MenuCheckboxItem,
+  MenuItem,
+  MenuPopup,
+  MenuSeparator,
+  MenuTrigger,
+} from "../ui/menu";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+import "./SidebarMachineRow.css";
+
+export function SidebarMachineRow({
+  environments,
+  primaryEnvironmentId,
+  machineById,
+  selectedIds,
+  onChange,
+}: {
+  readonly environments: Parameters<typeof buildSidebarEnvironmentScopeItems>[0]["environments"];
+  readonly primaryEnvironmentId: EnvironmentId | null;
+  readonly machineById: ReadonlyMap<EnvironmentId, EnvironmentMachineKind>;
+  readonly selectedIds: ReadonlySet<EnvironmentId> | null;
+  readonly onChange: (keys: string[]) => void;
+}) {
+  const gt = useGT();
+  const messages = useMessages();
+  const [open, setOpen] = useState(false);
+  const isMac = isMacPlatform(navigator.platform);
+  const items = buildSidebarEnvironmentScopeItems({ environments, primaryEnvironmentId }, messages);
+  if (items.length === 0) return null;
+  const selected = items.filter(
+    (item) => item.environmentId !== null && selectedIds?.has(item.environmentId),
+  );
+  const label =
+    selected.length === 0 ? gt("All machines") : selected.map((item) => item.label).join(", ");
+  const icon = (id: EnvironmentId | null) =>
+    id === null ? (
+      <MonitorSmartphoneIcon className="size-4 shrink-0" />
+    ) : (
+      <EnvironmentMachineIcon kind={machineById.get(id) ?? "server"} className="size-4 shrink-0" />
+    );
+
+  return (
+    <div data-machine-row="root">
+      <Menu open={open} onOpenChange={setOpen}>
+        <Tooltip>
+          <TooltipTrigger
+            render={
+              <MenuTrigger
+                render={
+                  <button
+                    type="button"
+                    data-machine-row="trigger"
+                    aria-label={gt("Filter threads by machine: {label}", { label })}
+                  />
+                }
+              />
+            }
+          >
+            {selected.length === 0
+              ? icon(null)
+              : selected.map((item) => <span key={item.value}>{icon(item.environmentId)}</span>)}
+            <span data-machine-row="label">{label}</span>
+            <ChevronDownIcon className="size-3.5 shrink-0" />
+          </TooltipTrigger>
+          <TooltipPopup side="bottom">{label}</TooltipPopup>
+        </Tooltip>
+        <MenuPopup align="start">
+          <MenuItem onClick={() => onChange([])}>
+            <span className="flex min-w-0 items-center gap-2">
+              {icon(null)}
+              <span>
+                <T>All machines</T>
+              </span>
+            </span>
+          </MenuItem>
+          <MenuSeparator />
+          {items
+            .filter(
+              (item): item is typeof item & { environmentId: EnvironmentId } =>
+                item.environmentId !== null,
+            )
+            .map((item) => (
+              <MenuCheckboxItem
+                key={item.value}
+                checked={selectedIds?.has(item.environmentId) ?? false}
+                closeOnClick={false}
+                onCheckedChange={(_, details) => {
+                  const event = details.event;
+                  if (isMac && event instanceof MouseEvent && event.ctrlKey) {
+                    details.cancel();
+                    return;
+                  }
+                  const additive =
+                    event instanceof MouseEvent && (isMac ? event.metaKey : event.ctrlKey);
+                  onChange(
+                    nextSidebarEnvironmentScopeKeys(
+                      [...(selectedIds ?? [])],
+                      item.environmentId,
+                      additive,
+                      environments.map((environment) => environment.environmentId),
+                    ),
+                  );
+                  if (!additive) setOpen(false);
+                }}
+              >
+                <span className="flex min-w-0 items-center gap-2">
+                  {icon(item.environmentId)}
+                  <span className="min-w-0 truncate">{item.label}</span>
+                </span>
+              </MenuCheckboxItem>
+            ))}
+        </MenuPopup>
+      </Menu>
+    </div>
+  );
+}
