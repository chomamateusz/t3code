+        with:
+          name: desktop-linux-x64
+          path: release-assets
+
+      - name: Verify AppImage and deb fork feeds and allowlists
+        shell: bash
+        run: |
+          set -euo pipefail
+          shopt -s nullglob
+          images=(release-assets/*.AppImage)
+          debs=(release-assets/*.deb)
+          [[ ${#images[@]} -eq 1 && ${#debs[@]} -eq 1 ]]
+          chmod +x "${images[0]}"
+          "${images[0]}" --appimage-extract > /dev/null
+          dpkg-deb -x "${debs[0]}" unpacked-deb
+          for root in squashfs-root unpacked-deb; do
+            mapfile -t archives < <(find "$root" -type f -name app.asar)
+            [[ ${#archives[@]} -eq 1 ]]
+            node scripts/verify-fork-update-feed.ts "$(dirname "${archives[0]}")"
+          done
+
+  release:
+    name: Publish GitHub Release
+    needs: [preflight, verify_mac, verify_linux]
+    if: ${{ github.repository == 'chomamateusz/t3code' && !failure() && !cancelled() && needs.preflight.result == 'success' && needs.verify_mac.result == 'success' && needs.verify_linux.result == 'success' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      actions: read
+      contents: write
+    steps:
+      - name: Download desktop artifacts
+        uses: actions/download-artifact@v8
+        with:
+          pattern: desktop-*
+          merge-multiple: true
+          path: release-assets
+
+      - name: Download CLI archives
+        uses: actions/download-artifact@v8
+        with:
+          pattern: cli-*
+          merge-multiple: true
+          path: release-assets
+
+      - name: Verify CLI archives and both update manifests
+        shell: bash
+        env:
+          VERSION: ${{ needs.preflight.outputs.version }}
+        run: |
+          set -euo pipefail
+          test -s release-assets/latest-mac.yml
+          test -s release-assets/latest-linux.yml
+          for platform in linux-x64 darwin-arm64; do
+            archive="release-assets/t3-$VERSION-$platform.tar.gz"
+            test -s "$archive"
+            mkdir -p "unpacked-cli/$platform"
+            tar -xzf "$archive" --strip-components=1 -C "unpacked-cli/$platform"
+            test -f "unpacked-cli/$platform/t3"
+          done
+
+      - name: Write CLI archive checksums
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd release-assets
+          shopt -s nullglob
+          archives=(t3-*.tar.gz t3-*.zip)
+          if [[ ${#archives[@]} -eq 0 ]]; then
+            echo "No CLI archives were produced." >&2
+            exit 1
+          fi
+          sha256sum "${archives[@]}" > SHA256SUMS
+          cat SHA256SUMS
+
+      - name: Publish release
+        uses: softprops/action-gh-release@efb35369e0ad2afab669f228072c1b0d510eae64 # v3
+        with:
+          tag_name: ${{ needs.preflight.outputs.tag }}
+          target_commitish: ${{ needs.preflight.outputs.ref }}
+          name: T3 Code ${{ needs.preflight.outputs.tag }}
+          generate_release_notes: true
+          draft: ${{ inputs.draft }}
+          prerelease: false
+          make_latest: ${{ !inputs.draft }}
+          files: |
+            release-assets/*.dmg
+            release-assets/*.zip
+            release-assets/*.AppImage
+            release-assets/*.deb
+            release-assets/*.blockmap
+            release-assets/latest*.yml
+            release-assets/t3-*-darwin-arm64.tar.gz
+            release-assets/t3-*-linux-x64.tar.gz
+            release-assets/SHA256SUMS
+          fail_on_unmatched_files: true
+          token: ${{ github.token }}
