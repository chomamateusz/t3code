diff --git a/apps/desktop/src/updates/forkFeedPolicy.test.ts b/apps/desktop/src/updates/forkFeedPolicy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4d8b390c1e35711cb223b69dff925dcc66486041
--- /dev/null
+++ b/apps/desktop/src/updates/forkFeedPolicy.test.ts
@@ -0,0 +1,206 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Stream from "effect/Stream";
+
+import * as ElectronUpdater from "../electron/ElectronUpdater.ts";
+import * as DesktopUpdates from "./DesktopUpdates.ts";
+import { makeHarness } from "./updatesTestHarness.ts";
+
+const repository = "chomamateusz/t3code";
+const feed = "provider: github\nowner: chomamateusz\nrepo: t3code\n";
+const refusal = `Updates for this build come only from ${repository}`;
+
+function emitState(
+  harness: ReturnType<typeof makeHarness>,
+  event: "update-available" | "update-downloaded",
+) {
+  return Effect.gen(function* () {
+    const updates = yield* DesktopUpdates.DesktopUpdates;
+    const { changes } = yield* updates.subscribe;
+    const next = yield* Stream.runHead(changes).pipe(Effect.forkChild);
+    harness.emit(event, { version: "0.0.46-fork.2" });
+    yield* Fiber.join(next);
+  });
+}
+
+describe("configured desktop update repository", () => {
+  it.effect.each([
+    undefined,
+    "provider: github\nowner: pingdotgg\nrepo: t3code\n",
+    `${feed}host: updates.example.com\n`,
+    `${feed}protocol: http\n`,
+    "provider: generic\nurl: https://github.com/chomamateusz/t3code\n",
+  ])("refuses a missing or foreign packaged feed: %s", (appUpdateYml) => {
+    const harness = makeHarness({
+      allowedUpdateRepository: repository,
+      appUpdateYml,
+      env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+    });
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        const download = yield* updates.download;
+        const install = yield* updates.install;
+        const prepared = yield* updates.installPrepared("0.0.46-fork.2");
+        for (const result of [download, install, prepared]) {
+          assert.equal(result.accepted, false);
+          assert.equal(result.state.enabled, false);
+          assert.equal(result.state.status, "disabled");
+          assert.equal(result.state.message, refusal);
+        }
+        assert.equal(harness.downloadCount(), 0);
+        assert.equal(harness.quitAndInstalls(), 0);
+      }),
+    ).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("downloads and installs from a case-insensitive packaged fork feed on latest", () => {
+    const harness = makeHarness({
+      allowedUpdateRepository: "Chomamateusz/T3code",
+      appUpdateYml: "provider: github\nowner: chomamateusz\nrepo: T3Code\n",
+      appVersion: "0.0.46-fork.1",
+      env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+    });
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        assert.equal((yield* updates.getState).enabled, true);
+        assert.equal(harness.channel(), "latest");
+        assert.equal(harness.allowPrerelease(), false);
+        assert.equal(harness.allowDowngrade(), false);
+        yield* updates.setChannel("nightly");
+        assert.equal((yield* updates.getState).channel, "latest");
+        assert.equal(harness.channel(), "latest");
+        assert.equal(harness.allowPrerelease(), false);
+        assert.equal(harness.allowDowngrade(), false);
+        yield* emitState(harness, "update-available");
+        assert.equal((yield* updates.download).completed, true);
+        yield* emitState(harness, "update-downloaded");
+        assert.equal((yield* updates.install).accepted, true);
+        assert.equal(harness.downloadCount(), 1);
+        assert.equal(harness.quitAndInstalls(), 1);
+      }),
+    ).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("ignores runtime feed overrides when the allowed repository is baked", () => {
+    const harness = makeHarness({
+      allowedUpdateRepository: repository,
+      appUpdateYml: feed,
+      env: {
+        T3CODE_DESKTOP_MOCK_UPDATES: "true",
+        T3CODE_DESKTOP_UPDATE_REPOSITORY: "pingdotgg/t3code",
+        T3CODE_ALLOWED_UPDATE_REPOSITORY: "pingdotgg/t3code",
+        T3CODE_RELEASE_REPOSITORY: "pingdotgg/t3code",
+        T3CODE_RELEASE_BASE_URL: "https://mirror.example/t3",
+      },
+    });
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        const updater = yield* ElectronUpdater.ElectronUpdater;
+        yield* updates.configure;
+        assert.equal((yield* updates.getState).enabled, true);
+        assert.equal(yield* updater.feedURL, undefined);
+        yield* emitState(harness, "update-available");
+        assert.equal((yield* updates.download).completed, true);
+      }),
+    ).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect.each([undefined, "https://mirror.example/t3"])(
+    "keeps managed update restrictions alongside the fork allowlist: %s",
+    (feedUrl) => {
+      const harness = makeHarness({
+        allowedUpdateRepository: repository,
+        appUpdateYml: feed,
+        policy: {
+          mode: "off",
+          feedUrl,
+          allowNightly: false,
+          message: "Managed updates are disabled.",
+        },
+      });
+      return Effect.scoped(
+        Effect.gen(function* () {
+          const updates = yield* DesktopUpdates.DesktopUpdates;
+          yield* updates.configure;
+          const state = yield* updates.getState;
+          assert.equal(state.enabled, false);
+          assert.equal(
+            state.message,
+            feedUrl === undefined ? "Managed updates are disabled." : refusal,
+          );
+          assert.equal((yield* updates.check("menu")).checked, false);
+          assert.equal((yield* updates.download).accepted, false);
+          assert.equal((yield* updates.install).accepted, false);
+          assert.equal(harness.downloadCount(), 0);
+          assert.equal(harness.quitAndInstalls(), 0);
+        }),
+      ).pipe(Effect.provide(harness.layer));
+    },
+  );
+
+  it.effect("rechecks the feed after stopping backends and recovers a refused install", () => {
+    let redirect = Effect.void;
+    const harness = makeHarness({
+      allowedUpdateRepository: repository,
+      appUpdateYml: feed,
+      env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+      stopBackend: Effect.suspend(() => redirect),
+    });
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        const updater = yield* ElectronUpdater.ElectronUpdater;
+        yield* updates.configure;
+        yield* emitState(harness, "update-downloaded");
+        redirect = updater.setFeedURL("https://updates.example.com");
+        const result = yield* updates.installPrepared("0.0.46-fork.2");
+        assert.equal(result.failed, true);
+        assert.equal(result.state.status, "disabled");
+        assert.equal(result.state.message, refusal);
+        assert.equal(harness.quitAndInstalls(), 0);
+        assert.deepEqual(harness.installSteps, ["closeSshTunnels", "startBackend"]);
+        assert.equal(harness.updateRestartMarkers.size, 0);
+      }),
+    ).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect.each(["download", "install", "installPrepared"] as const)(
+    "refuses a feed override before %s",
+    (action) => {
+      const harness = makeHarness({
+        allowedUpdateRepository: repository,
+        appUpdateYml: feed,
+        env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+      });
+      return Effect.scoped(
+        Effect.gen(function* () {
+          const updates = yield* DesktopUpdates.DesktopUpdates;
+          const updater = yield* ElectronUpdater.ElectronUpdater;
+          yield* updates.configure;
+          yield* emitState(harness, "update-available");
+          if (action !== "download") yield* emitState(harness, "update-downloaded");
+          yield* updater.setFeedURL({
+            provider: "github",
+            owner: "chomamateusz",
+            repo: "t3code",
+            host: "updates.example.com",
+          });
+          const result = yield* action === "installPrepared"
+            ? updates.installPrepared("0.0.46-fork.2")
+            : updates[action];
+          assert.equal(result.accepted, false);
+          assert.equal(result.state.status, "disabled");
+          assert.equal(result.state.message, refusal);
+          assert.equal(harness.downloadCount(), 0);
+          assert.equal(harness.quitAndInstalls(), 0);
+        }),
+      ).pipe(Effect.provide(harness.layer));
+    },
+  );
+});
diff --git a/apps/desktop/src/updates/forkUpdateProvider.test.ts b/apps/desktop/src/updates/forkUpdateProvider.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5aeee351553d854ce241aa784112894449d5abc6
--- /dev/null
+++ b/apps/desktop/src/updates/forkUpdateProvider.test.ts
@@ -0,0 +1,128 @@
+import { assert, describe, it } from "@effect/vitest";
+import { afterEach, vi } from "vite-plus/test";
+import * as Effect from "effect/Effect";
+import { AppUpdater } from "electron-updater/out/AppUpdater.js";
+import { ElectronHttpExecutor } from "electron-updater/out/electronHttpExecutor.js";
+import { GitHubProvider } from "electron-updater/out/providers/GitHubProvider.js";
+
+import * as DesktopUpdates from "./DesktopUpdates.ts";
+import { makeHarness } from "./updatesTestHarness.ts";
+
+class DiscoveryUpdater extends AppUpdater {
+  provider: GitHubProvider | undefined;
+
+  constructor() {
+    super(undefined, {
+      version: "0.0.46-fork.1",
+      name: "T3 Code",
+      isPackaged: true,
+      appUpdateConfigPath: "/unused/app-update.yml",
+      userDataPath: "/unused/userdata",
+      baseCachePath: "/unused/cache",
+      whenReady: () => Promise.resolve(),
+      relaunch: () => {},
+      quit: () => {},
+      onQuit: () => {},
+    });
+    this.autoDownload = false;
+    this.logger = null;
+  }
+
+  protected override async getUpdateInfoAndProvider() {
+    if (!this.provider) {
+      throw new Error("Missing test provider");
+    }
+    return { info: await this.provider.getLatestVersion(), provider: this.provider };
+  }
+
+  protected override doDownloadUpdate(): Promise<string[]> {
+    throw new Error("Unexpected download during discovery");
+  }
+
+  override quitAndInstall() {
+    throw new Error("Unexpected install during discovery");
+  }
+}
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllEnvs();
+});
+
+describe("fork GitHub release discovery", () => {
+  it.effect.each(
+    (["darwin", "linux"] as const).flatMap((platform) =>
+      (
+        [
+          ["0.0.46-fork.2", true],
+          ["0.0.47-fork.1", true],
+          ["0.0.46", true],
+          ["0.0.46-fork.1", false],
+          ["0.0.46-fork.0", false],
+          ["0.0.45", false],
+        ] as const
+      ).map(([version, available]) => ({ platform, version, available })),
+    ),
+  )(
+    "$platform: $version availability on latest is $available",
+    ({ platform, version, available }) => {
+      const harness = makeHarness({
+        allowedUpdateRepository: "chomamateusz/t3code",
+        appUpdateYml: "provider: github\nowner: chomamateusz\nrepo: t3code\n",
+        appVersion: "0.0.46-fork.1",
+        env: {
+          T3CODE_DESKTOP_MOCK_UPDATES: "false",
+          ...(platform === "linux" ? { APPIMAGE: "/tmp/t3.AppImage" } : {}),
+        },
+        platform,
+      });
+      return Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        yield* updates.setChannel("nightly");
+        vi.stubEnv("TEST_UPDATER_ARCH", "x64");
+        const updater = new DiscoveryUpdater();
+        updater.channel = harness.channel();
+        updater.allowPrerelease = harness.allowPrerelease();
+        updater.allowDowngrade = harness.allowDowngrade();
+        assert.equal(updater.channel, "latest");
+        assert.equal(updater.allowPrerelease, false);
+        assert.equal(updater.allowDowngrade, false);
+
+        const manifest = platform === "darwin" ? "latest-mac.yml" : "latest-linux.yml";
+        const basePath = "/chomamateusz/t3code/releases";
+        const requests: string[] = [];
+        const executor = new ElectronHttpExecutor();
+        vi.spyOn(executor, "request").mockImplementation(async (options) => {
+          assert.equal(options.hostname, "github.com");
+          const path = options.path ?? "";
+          requests.push(path);
+          if (path === `${basePath}.atom`) {
+            return `<feed><entry><title>Prerelease</title><link href="https://github.com/chomamateusz/t3code/releases/tag/v99.0.0-fork.1"/><content>Preview</content></entry><entry><title>Production release</title><link href="https://github.com/chomamateusz/t3code/releases/tag/v${version}"/><content>Release notes</content></entry></feed>`;
+          }
+          if (path === `${basePath}/latest`) {
+            return JSON.stringify({ tag_name: `v${version}`, prerelease: false });
+          }
+          if (path === `${basePath}/download/v${version}/${manifest}`) {
+            return `version: ${version}\nfiles:\n  - url: t3.zip\n    sha512: test\n`;
+          }
+          throw new Error(`Unexpected release request: ${path}`);
+        });
+        updater.provider = new GitHubProvider(
+          { provider: "github", owner: "chomamateusz", repo: "t3code" },
+          updater,
+          { platform, executor, isUseMultipleRangeRequest: false },
+        );
+        const result = yield* Effect.promise(() => updater.checkForUpdates());
+        assert.equal(result?.isUpdateAvailable, available);
+        assert.equal(result?.updateInfo.version, version);
+        assert.equal(result?.updateInfo.releaseName, "Production release");
+        assert.deepEqual(requests, [
+          `${basePath}.atom`,
+          `${basePath}/latest`,
+          `${basePath}/download/v${version}/${manifest}`,
+        ]);
+      }).pipe(Effect.provide(harness.layer), Effect.scoped);
+    },
+  );
+});
