+++ b/.github/workflows/release-fork.yml
@@ -0,0 +1,442 @@
+name: Release fork
+
+on:
+  workflow_dispatch:
+    inputs:
+      version:
+        description: "Fork version (for example 0.1.2-fork.2026102201)"
+        required: true
+        type: string
+      ref:
+        description: "Git ref to build; defaults to the dispatching ref"
+        required: false
+        type: string
+      draft:
+        description: "Create a draft release"
+        required: false
+        default: true
+        type: boolean
+
+concurrency:
+  group: release-fork-${{ inputs.version }}
+  cancel-in-progress: false
+
+permissions:
+  actions: read
+  contents: read
+
+jobs:
+  preflight:
+    name: Preflight
+    if: ${{ github.repository == 'chomamateusz/t3code' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    outputs:
+      ref: ${{ steps.release_meta.outputs.ref }}
+      tag: ${{ steps.release_meta.outputs.tag }}
+      version: ${{ steps.release_meta.outputs.version }}
+    steps:
+      - name: Checkout release commit
+        uses: actions/checkout@v6
+        with:
+          ref: ${{ inputs.ref || github.ref }}
+          fetch-depth: 1
+          persist-credentials: false
+
+      - id: release_meta
+        name: Resolve release metadata
+        shell: bash
+        env:
+          VERSION: ${{ inputs.version }}
+        run: |
+          set -euo pipefail
+          if [[ ! "$VERSION" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-fork\.(0|[1-9][0-9]*)$ ]]; then
+            echo "Invalid fork release version: $VERSION" >&2
+            exit 1
+          fi
+          {
+            echo "version=$VERSION"
+            echo "tag=v$VERSION"
+            echo "ref=$(git rev-parse HEAD)"
+          } >> "$GITHUB_OUTPUT"
+
+      - name: Require an unused and increasing release version
+        uses: actions/github-script@v8
+        env:
+          TAG: ${{ steps.release_meta.outputs.tag }}
+        with:
+          script: |
+            const missing = async (request) => {
+              try {
+                await request();
+                return false;
+              } catch (error) {
+                if (error.status === 404) return true;
+                throw error;
+              }
+            };
+
+            const owner = context.repo.owner;
+            const repo = context.repo.repo;
+            const tag = process.env.TAG;
+            const tagMissing = await missing(() => github.rest.git.getRef({
+              owner,
+              repo,
+              ref: `tags/${tag}`,
+            }));
+            const releases = await github.paginate(github.rest.repos.listReleases, {
+              owner, repo, per_page: 100,
+            });
+            const { compareExactServiceVersions, isExactServiceVersion } = await import(
+              `${process.env.GITHUB_WORKSPACE}/apps/server/src/cloud/serviceProtocol.ts`
+            );
+            const version = tag.slice(1);
+            const versions = releases
+              .filter((release) => !release.draft)
+              .map((release) => release.tag_name.replace(/^v/, ''))
+              .filter((candidate) => isExactServiceVersion(candidate) && /-fork\./.test(candidate))
+              .sort((a, b) => compareExactServiceVersions(b, a));
+            const newest = versions[0];
+            if (newest !== undefined && compareExactServiceVersions(version, newest) <= 0) {
+              core.setFailed(`Version ${version} must be greater than the newest existing fork release: ${newest}.`);
+              return;
+            }
+            if (!tagMissing || releases.some((release) => release.tag_name === tag)) {
+              core.setFailed(`Tag or release ${tag} already exists.`);
+              return;
+            }
+
+  mac_signing_preflight:
+    name: Require macOS signing inputs
+    needs: [preflight]
+    if: ${{ github.repository == 'chomamateusz/t3code' && needs.preflight.result == 'success' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    env:
+      CSC_LINK: ${{ secrets.CSC_LINK }}
+      CSC_KEY_PASSWORD: ${{ secrets.CSC_KEY_PASSWORD }}
+      APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}
+      APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
+      APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}
+      MACOS_PROVISIONING_PROFILE: ${{ secrets.MACOS_PROVISIONING_PROFILE }}
+      APPLE_TEAM_ID: ${{ vars.APPLE_TEAM_ID }}
+    steps:
+      - name: Check signing inputs
+        shell: bash
+        run: |
+          set -euo pipefail
+          required=(
+            CSC_LINK
+            CSC_KEY_PASSWORD
+            APPLE_API_KEY
+            APPLE_API_KEY_ID
+            APPLE_API_ISSUER
+            MACOS_PROVISIONING_PROFILE
+            APPLE_TEAM_ID
+          )
+          missing=()
+          for name in "${required[@]}"; do
+            if [[ -z "${!name:-}" ]]; then
+              missing+=("$name")
+            fi
+          done
+          if (( ${#missing[@]} > 0 )); then
+            printf 'Missing required macOS signing inputs: %s\n' "${missing[*]}" >&2
+            exit 1
+          fi
+
+  build_bundle:
+    name: Build JS bundle
+    env:
+      T3CODE_RELEASE_REPOSITORY: ${{ github.repository == 'chomamateusz/t3code' && github.repository || '' }}
+      T3CODE_ALLOWED_UPDATE_REPOSITORY: ${{ github.repository == 'chomamateusz/t3code' && github.repository || '' }}
+    needs: [preflight]
+    if: ${{ github.repository == 'chomamateusz/t3code' && needs.preflight.result == 'success' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    outputs:
+      clerk_publishable_key: ${{ steps.public_config.outputs.clerk_publishable_key }}
+      clerk_jwt_template: ${{ steps.public_config.outputs.clerk_jwt_template }}
+      clerk_cli_oauth_client_id: ${{ steps.public_config.outputs.clerk_cli_oauth_client_id }}
+      relay_url: ${{ steps.public_config.outputs.relay_url }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+        with:
+          ref: ${{ needs.preflight.outputs.ref }}
+          sparse-checkout: |
+            /*
+            !/.repos/
+          sparse-checkout-cone-mode: false
+
+      - id: public_config
+        name: Read T3 Connect public config
+        shell: bash
+        run: |
+          set -euo pipefail
+          read_value() {
+            sed -n "s/^$1=//p" .env.example
+          }
+
+          clerk_publishable_key="$(read_value T3CODE_CLERK_PUBLISHABLE_KEY)"
+          clerk_jwt_template="$(read_value T3CODE_CLERK_JWT_TEMPLATE)"
+          clerk_cli_oauth_client_id="$(read_value T3CODE_CLERK_CLI_OAUTH_CLIENT_ID)"
+          relay_url="$(read_value T3CODE_RELAY_URL)"
+          if [[ -z "$clerk_publishable_key" || -z "$clerk_jwt_template" || -z "$clerk_cli_oauth_client_id" || -z "$relay_url" ]]; then
+            echo ".env.example is missing required public T3 Connect configuration." >&2
+            exit 1
+          fi
+
+          {
+            echo "clerk_publishable_key=$clerk_publishable_key"
+            echo "clerk_jwt_template=$clerk_jwt_template"
+            echo "clerk_cli_oauth_client_id=$clerk_cli_oauth_client_id"
+            echo "relay_url=$relay_url"
+          } >> "$GITHUB_OUTPUT"
+          {
+            echo "T3CODE_CLERK_PUBLISHABLE_KEY=$clerk_publishable_key"
+            echo "T3CODE_CLERK_JWT_TEMPLATE=$clerk_jwt_template"
+            echo "T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=$clerk_cli_oauth_client_id"
+            echo "T3CODE_RELAY_URL=$relay_url"
+          } >> "$GITHUB_ENV"
+
+      - name: Setup Vite+
+        uses: voidzero-dev/setup-vp@250f29ce396baf5e8f24498e17c0dfdebabc26eb # v1
+        with:
+          node-version-file: package.json
+          cache: true
+          run-install: false
+
+      - name: Install bundle dependencies
+        run: vp install --filter=t3... --filter=@t3tools/web... --filter=@t3tools/desktop... --filter=@t3tools/scripts...
+
+      - name: Align package versions to release version
+        run: node scripts/update-release-package-versions.ts "${{ needs.preflight.outputs.version }}"
+
+      - uses: ./.github/actions/setup-apt-mirrors
+
+      - name: Install browser secret helper build libraries
+        run: sudo apt-get update && sudo apt-get install -y libsecret-1-dev pkg-config
+
+      - name: Build JS bundle
+        run: vp run build:desktop
+
+      - name: Upload JS bundle
+        uses: actions/upload-artifact@v7
+        with:
+          name: js-bundle
+          path: |
+            apps/server/dist
+            apps/desktop/dist-electron
+          if-no-files-found: error
+          retention-days: 1
+
+  desktop_mac_arm64:
+    name: Desktop macOS arm64
+    needs: [preflight, mac_signing_preflight, build_bundle]
+    if: ${{ github.repository == 'chomamateusz/t3code' && !cancelled() && needs.preflight.result == 'success' && needs.mac_signing_preflight.result == 'success' && needs.build_bundle.result == 'success' }}
+    uses: ./.github/workflows/release-desktop.yml
+    secrets:
+      CSC_LINK: ${{ secrets.CSC_LINK }}
+      CSC_KEY_PASSWORD: ${{ secrets.CSC_KEY_PASSWORD }}
+      APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}
+      APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
+      APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}
+      MACOS_PROVISIONING_PROFILE: ${{ secrets.MACOS_PROVISIONING_PROFILE }}
+    with:
+      version: ${{ needs.preflight.outputs.version }}
+      ref: ${{ needs.preflight.outputs.ref }}
+      release_channel: stable
+      relay_client_tracing: false
+      clerk_publishable_key: ${{ needs.build_bundle.outputs.clerk_publishable_key }}
+      clerk_jwt_template: ${{ needs.build_bundle.outputs.clerk_jwt_template }}
+      clerk_cli_oauth_client_id: ${{ needs.build_bundle.outputs.clerk_cli_oauth_client_id }}
+      relay_url: ${{ needs.build_bundle.outputs.relay_url }}
+      label: macOS arm64
+      runner: macos-15
+      platform: mac
+      target: dmg
+      arch: arm64
+      rust_target: aarch64-apple-darwin
+      resource_key: darwin-arm64
+      cli_archive: true
+
+  desktop_linux_x64:
+    name: Desktop Linux x64
+    needs: [preflight, build_bundle]
+    if: ${{ github.repository == 'chomamateusz/t3code' && !cancelled() && needs.preflight.result == 'success' && needs.build_bundle.result == 'success' }}
+    uses: ./.github/workflows/release-desktop.yml
+    with:
+      version: ${{ needs.preflight.outputs.version }}
+      ref: ${{ needs.preflight.outputs.ref }}
+      release_channel: stable
+      relay_client_tracing: false
+      clerk_publishable_key: ${{ needs.build_bundle.outputs.clerk_publishable_key }}
+      clerk_jwt_template: ${{ needs.build_bundle.outputs.clerk_jwt_template }}
+      clerk_cli_oauth_client_id: ${{ needs.build_bundle.outputs.clerk_cli_oauth_client_id }}
+      relay_url: ${{ needs.build_bundle.outputs.relay_url }}
+      label: Linux x64
+      runner: ubuntu-24.04
+      platform: linux
+      target: AppImage
+      arch: x64
+      rust_target: x86_64-unknown-linux-gnu
+      resource_key: linux-x64
+      cli_archive: true
+
+  verify_mac:
+    name: Verify macOS release artifacts
+    needs: [preflight, desktop_mac_arm64]
+    if: ${{ github.repository == 'chomamateusz/t3code' && !cancelled() && needs.desktop_mac_arm64.result == 'success' }}
+    runs-on: macos-15
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          ref: ${{ needs.preflight.outputs.ref }}
+          persist-credentials: false
+
+      - uses: voidzero-dev/setup-vp@250f29ce396baf5e8f24498e17c0dfdebabc26eb # v1
+        with:
+          node-version-file: package.json
+          run-install: false
+
+      - run: vp install --filter=@t3tools/scripts...
+
+      - uses: actions/download-artifact@v8
+        with:
+          name: desktop-mac-arm64
+          path: release-assets
+
+      - name: Verify signature, notarization, staple, and fork feed
+        shell: bash
+        run: |
+          set -euo pipefail
+          shopt -s nullglob
+          archives=(release-assets/*.zip)
+          [[ ${#archives[@]} -eq 1 ]]
+          ditto -x -k "${archives[0]}" unpacked
+          apps=(unpacked/*.app)
+          [[ ${#apps[@]} -eq 1 ]]
+          codesign --verify --deep --strict "${apps[0]}"
+          spctl -a -vv --type execute "${apps[0]}"
+          xcrun stapler validate "${apps[0]}"
+          node scripts/verify-fork-update-feed.ts "${apps[0]}/Contents/Resources"
+
+  verify_linux:
+    name: Verify Linux release artifacts
+    needs: [preflight, desktop_linux_x64]
+    if: ${{ github.repository == 'chomamateusz/t3code' && !cancelled() && needs.desktop_linux_x64.result == 'success' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          ref: ${{ needs.preflight.outputs.ref }}
+          persist-credentials: false
+
+      - uses: voidzero-dev/setup-vp@250f29ce396baf5e8f24498e17c0dfdebabc26eb # v1
+        with:
