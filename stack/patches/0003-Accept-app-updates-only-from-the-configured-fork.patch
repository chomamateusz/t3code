new file mode 100644
index 0000000000000000000000000000000000000000..e562a401b21b4aadc718d02e8b573624710e8b0d
--- /dev/null
+++ b/scripts/verify-fork-update-feed.test.ts
@@ -0,0 +1,37 @@
+// @effect-diagnostics nodeBuiltinImport:off - Packaged archive verification uses asar's synchronous filesystem API.
+import * as NodeFSP from "node:fs/promises";
+import * as NodePath from "node:path";
+import * as NodeOS from "node:os";
+import { createPackage } from "@electron/asar";
+import { expect, it } from "vite-plus/test";
+
+import { verifyForkUpdateFeed } from "./verify-fork-update-feed.ts";
+
+it.each([
+  ["chomamateusz", "chomamateusz/t3code", true],
+  ["pingdotgg", "chomamateusz/t3code", false],
+  ["chomamateusz", "pingdotgg/t3code", false],
+  ["chomamateusz", undefined, false],
+] as const)(
+  "checks the packaged feed owner %s and baked allowlist %s",
+  async (owner, allowed, valid) => {
+    const root = await NodeFSP.mkdtemp(NodePath.join(NodeOS.tmpdir(), "t3-fork-feed-"));
+    try {
+      const app = NodePath.join(root, "app");
+      await NodeFSP.mkdir(app);
+      await NodeFSP.writeFile(
+        NodePath.join(app, "package.json"),
+        JSON.stringify({ t3codeAllowedUpdateRepository: allowed }),
+      );
+      await createPackage(app, NodePath.join(root, "app.asar"));
+      await NodeFSP.writeFile(
+        NodePath.join(root, "app-update.yml"),
+        `provider: github\nowner: ${owner}\nrepo: t3code\n`,
+      );
+      if (valid) expect(() => verifyForkUpdateFeed(root)).not.toThrow();
+      else expect(() => verifyForkUpdateFeed(root)).toThrow();
+    } finally {
+      await NodeFSP.rm(root, { recursive: true, force: true });
+    }
+  },
+);
diff --git a/scripts/verify-fork-update-feed.ts b/scripts/verify-fork-update-feed.ts
new file mode 100644
index 0000000000000000000000000000000000000000..701a37780c84a68aa9cc2b7583bc3b5a28c78588
--- /dev/null
+++ b/scripts/verify-fork-update-feed.ts
@@ -0,0 +1,36 @@
+// @effect-diagnostics nodeBuiltinImport:off - Packaged archive verification uses asar's synchronous filesystem API.
+import * as NodeFS from "node:fs";
+import * as NodePath from "node:path";
+import { extractFile } from "@electron/asar";
+import { fromYaml } from "@t3tools/shared/schemaYaml";
+import * as Schema from "effect/Schema";
+
+const decodeFeed = Schema.decodeUnknownSync(
+  fromYaml(
+    Schema.Struct({
+      provider: Schema.Literal("github"),
+      owner: Schema.Literal("chomamateusz"),
+      repo: Schema.Literal("t3code"),
+    }),
+  ),
+);
+const decodePackage = Schema.decodeUnknownSync(
+  Schema.fromJsonString(
+    Schema.Struct({
+      t3codeAllowedUpdateRepository: Schema.Literal("chomamateusz/t3code"),
+    }),
+  ),
+);
+
+export function verifyForkUpdateFeed(resourcesPath: string): void {
+  decodeFeed(NodeFS.readFileSync(NodePath.join(resourcesPath, "app-update.yml"), "utf8"));
+  decodePackage(
+    extractFile(NodePath.join(resourcesPath, "app.asar"), "package.json").toString("utf8"),
+  );
+}
+
+if (import.meta.main) {
+  const paths = process.argv.slice(2);
+  if (paths.length === 0) throw new Error("Expected at least one packaged resources directory.");
+  for (const path of paths) verifyForkUpdateFeed(path);
+}
