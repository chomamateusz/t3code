+
+function project(id: string, environmentId: EnvironmentId, repository: string): Project {
+  return {
+    id: ProjectId.make(id),
+    environmentId,
+    title: repository,
+    workspaceRoot: `/work/${id}`,
+    repositoryIdentity: {
+      canonicalKey: `github.com/example/${repository}`,
+      locator: {
+        source: "git-remote",
