+import { mFallback, msg } from "gt-i18n";
+import type { MFunctionType } from "gt-i18n/types";
+
+import { QUEUED_MESSAGE_MERGE_REASONS } from "./queuedMessageMerge.ts";
+
+const REASON_COPY: Readonly<Record<keyof typeof QUEUED_MESSAGE_MERGE_REASONS, string>> = {
+  loading: msg("Some queued messages are still loading."),
+  guest: msg("A guest's message can't be combined with others."),
+  automation: msg("Messages from agents and automations are sent on their own."),
+  command: msg("Commands are sent on their own."),
+  freshContext: msg("A message that starts a fresh session is sent on its own."),
+  continuation: msg("Plan and continuation messages are sent on their own."),
+  outputSchema: msg("A message that asks for a result is sent on its own."),
+  models: msg("Queued messages use different models."),
+  tooFew: msg("Queue two or more messages to send them as one."),
+  sharedAttachment: msg("Queued messages share an attachment."),
+  conflictingContext: msg("Queued messages have conflicting context."),
+  tooMuchContext: msg("Queued messages carry too much context to send as one."),
+};
+
+export function queuedMessageMergeReason(
+  reason: string,
+  resolve: MFunctionType = mFallback,
+): string {
+  const key = (
+    Object.keys(QUEUED_MESSAGE_MERGE_REASONS) as Array<keyof typeof QUEUED_MESSAGE_MERGE_REASONS>
+  ).find((candidate) => QUEUED_MESSAGE_MERGE_REASONS[candidate] === reason);
+  return key === undefined ? reason : resolve(REASON_COPY[key]);
+}
