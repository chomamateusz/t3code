+import {
+  combineSidebarProjectBadges,
+  SIDEBAR_PROJECT_BADGE_LEGEND,
+  summarizeSidebarProjectBadge,
+  type SidebarProjectBadge,
+  type SidebarProjectBadgeState,
+} from "../Sidebar.logic";
