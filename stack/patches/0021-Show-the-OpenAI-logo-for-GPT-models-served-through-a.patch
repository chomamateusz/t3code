index 0000000000000000000000000000000000000000..61a8232cdbe145d7599edfe209a349bfe020d7da
--- /dev/null
+++ b/apps/web/src/components/chat/providerIconUtils.test.ts
@@ -0,0 +1,37 @@
+import { ProviderDriverKind } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { modelBrandDriverKind } from "./providerIconUtils";
+
+const claude = ProviderDriverKind.make("claudeAgent");
+const codex = ProviderDriverKind.make("codex");
+const cursor = ProviderDriverKind.make("cursor");
+const custom = ProviderDriverKind.make("openaiCompatible");
+
+describe("modelBrandDriverKind", () => {
+  it("shows the OpenAI logo for a proxied GPT model by its display name", () => {
+    expect(
+      modelBrandDriverKind(claude, { slug: "claude-fable-5-dd-los-2.6-tpg", name: "GPT 6.2 Sol" }),
+    ).toBe(codex);
+    expect(modelBrandDriverKind(claude, { slug: "proxy-alias", name: "gpt-6-astra" })).toBe(codex);
+    expect(modelBrandDriverKind(cursor, { slug: "x", name: "GPT5 Codex" })).toBe(codex);
+  });
+
+  it("shows the OpenAI logo for a GPT slug without a name", () => {
+    expect(modelBrandDriverKind(claude, { slug: "GPT-6.2-sol" })).toBe(codex);
+  });
+
+  it("keeps the driver's logo for other models", () => {
+    expect(modelBrandDriverKind(claude, { slug: "claude-opus-5-5", name: "Claude Opus 5.5" })).toBe(
+      claude,
+    );
+    expect(modelBrandDriverKind(claude, { slug: "gptx", name: "GPTX Turbo" })).toBe(claude);
+    expect(modelBrandDriverKind(cursor, { slug: "composer-2.5", name: "Composer" })).toBe(cursor);
+    expect(modelBrandDriverKind(claude, null)).toBe(claude);
+    expect(modelBrandDriverKind(claude, undefined)).toBe(claude);
+  });
+
+  it("keeps a custom endpoint's own tile", () => {
+    expect(modelBrandDriverKind(custom, { slug: "gpt-6-luna", name: "GPT 6 Luna" })).toBe(custom);
+  });
+});
