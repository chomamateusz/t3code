-import type { ProviderDriverKind } from "@t3tools/contracts";
+import { ProviderDriverKind } from "@t3tools/contracts";
 import { resolveModelShortName } from "@t3tools/client-runtime/provider-clients";
 
 export type ModelEsque = {
@@ -42,3 +42,23 @@ export function getTriggerDisplayModelName(
   const shortName = resolveModelShortName(model, driverKind);
   return getDisplayModelName({ ...model, shortName }, { preferShortName: true });
 }
+
+export type ModelIdentity = {
+  readonly slug?: string | null | undefined;
+  readonly name?: string | null | undefined;
+};
+
+const OPENAI_LOGO_DRIVER_KIND = ProviderDriverKind.make("codex");
+const GPT_MODEL_NAME = /^gpt[\s\d-]/i;
+
+export function modelBrandDriverKind(
+  driverKind: ProviderDriverKind,
+  model: ModelIdentity | null | undefined,
+): ProviderDriverKind {
+  // A custom endpoint's tile is its only identity and already carries the OpenAI mark.
+  if (!model || driverKind === "openaiCompatible") return driverKind;
+  const isGpt =
+    GPT_MODEL_NAME.test(model.name?.trim() ?? "") ||
+    (model.slug?.trim().toLowerCase().startsWith("gpt-") ?? false);
+  return isGpt ? OPENAI_LOGO_DRIVER_KIND : driverKind;
+}
