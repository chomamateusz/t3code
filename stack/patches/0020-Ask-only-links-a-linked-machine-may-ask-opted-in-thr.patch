+  const answerOf = Effect.fn("LinkedQuestions.answerOf")(function* (
+    projectId: ProjectId,
+    threadId: ThreadId,
+    chain: ReadonlyArray<OrchestrationV2Run>,
+  ) {
+    const { messages } = yield* threads
+      .getProjectThreadRecords({ projectId, threadId }, ["messages"], {
+        messageRunIds: chain.map((run) => run.id),
+        messageRoles: ["user", "assistant"],
+      })
+      .pipe(Effect.mapError(() => unavailable));
+    const chainPrompts = new Set(chain.map((run) => run.userMessageId));
+    const otherInputAt = Math.min(
+      ...messages
+        .filter((message) => message.role === "user" && !chainPrompts.has(message.id))
+        .map((message) => DateTime.toEpochMillis(message.createdAt)),
+    );
+    const text = messages
+      .filter(
+        (message) =>
+          message.role === "assistant" &&
+          message.text.trim() !== "" &&
+          DateTime.toEpochMillis(message.createdAt) < otherInputAt,
+      )
+      .toSorted(
+        (left, right) =>
+          DateTime.toEpochMillis(left.createdAt) - DateTime.toEpochMillis(right.createdAt),
+      )
+      .map((message) => message.text)
+      .join("\n\n");
