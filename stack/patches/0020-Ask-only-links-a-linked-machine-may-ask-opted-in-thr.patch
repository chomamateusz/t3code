+
+  const wait = Effect.fn("LinkedQuestions.wait")(function* (
+    scope: McpInvocationScope,
+    input: Omit<OrchestratorMcpAskWaitInput, "environmentId">,
+  ) {
+    const origin = yield* askingLink(scope);
+    const shell = yield* threads
+      .getThreadShell(input.threadId)
+      .pipe(Effect.mapError(() => unavailable));
+    if (shell === null || shell.deletedAt !== null) return yield* noSuchQuestion(input.questionId);
+    const records = yield* threads
+      .getProjectThreadRecords(
+        { projectId: shell.projectId, threadId: shell.id },
+        ["messages", "runs"],
+        { messageIds: [input.questionId] },
+      )
+      .pipe(Effect.mapError(() => unavailable));
+    const question = records.messages.find((message) => message.id === input.questionId);
+    const first =
+      question?.runId == null ? undefined : records.runs.find((run) => run.id === question.runId);
+    if (question?.linkOrigin?.sessionId !== origin.sessionId || first === undefined) {
+      return yield* noSuchQuestion(input.questionId);
+    }
+    const pending = { status: "pending" } satisfies OrchestratorMcpAskWaitResult;
+    const deadline =
+      (yield* Clock.currentTimeMillis) +
+      Math.min(ASK_MAX_WAIT_MS, input.timeoutMs ?? ASK_DEFAULT_WAIT_MS);
+    const currentChain = threads
+      .getProjectThreadRecords({ projectId: shell.projectId, threadId: shell.id }, ["runs"])
+      .pipe(
+        Effect.mapError(() => unavailable),
+        Effect.flatMap(({ runs }) => {
+          const chain = runChain(runs, first);
+          return chain.length === 0
+            ? Effect.fail(noSuchQuestion(input.questionId))
+            : Effect.succeed(chain);
+        }),
+      );
+    while (true) {
+      const last = (yield* currentChain).at(-1)!;
+      const remaining = deadline - (yield* Clock.currentTimeMillis);
+      const waited = yield* threads
+        .waitForThread({
+          projectId: shell.projectId,
+          threadId: shell.id,
+          runId: last.id,
+          timeoutMs: Math.max(1, remaining),
+        })
+        .pipe(Effect.mapError(() => unavailable));
+      if (waited.timedOut || waited.run === null) return pending;
+      const chain = yield* currentChain;
+      const settled = chain.at(-1)!;
+      if (settled.id !== last.id) continue;
+      if (settled.status === "completed") {
+        return {
+          status: "answered",
+          ...(yield* answerOf(shell.projectId, shell.id, chain)),
+        } satisfies OrchestratorMcpAskWaitResult;
+      }
+      return {
+        status: "failed",
+        error: yield* failureOf(shell.projectId, shell.id, settled),
+      } satisfies OrchestratorMcpAskWaitResult;
+    }
+  });
+
+  return LinkedQuestions.of({ list, send, wait });
+});
