+      const accepted = new Map<string, ThreadId>();
+      const created: Array<ThreadId> = [];
+      const questions = yield* LinkedQuestions.LinkedQuestions.pipe(
+        Effect.provide(
+          layerQuestions({
+            getThreadShell: () =>
+              Effect.succeed({
+                id: threadId,
+                projectId,
