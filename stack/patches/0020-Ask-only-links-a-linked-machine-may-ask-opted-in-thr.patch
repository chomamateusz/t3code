new file mode 100644
index 0000000000000000000000000000000000000000..280ebe70c5d42dfc711ec694198864398dcf4e24
--- /dev/null
+++ b/apps/server/src/mcp/toolkits/ask/handlers.ts
@@ -0,0 +1,34 @@
+import * as Effect from "effect/Effect";
+
+import * as LinkedQuestions from "../../../peer/LinkedQuestions.ts";
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+import * as McpToolAccess from "../../McpToolAccess.ts";
+import { AskToolkit } from "./tools.ts";
+
+const withQuestions = <A, E>(
+  use: (
+    questions: LinkedQuestions.LinkedQuestions["Service"],
+    scope: McpInvocationContext.McpInvocationScope,
+  ) => Effect.Effect<A, E>,
+) =>
+  Effect.flatMap(
+    Effect.all([LinkedQuestions.LinkedQuestions, McpInvocationContext.McpInvocationContext]),
+    ([questions, scope]) => use(questions, scope),
+  );
+
+const handlers = {
+  t3_ask_list: McpToolAccess.asks(
+    () => withQuestions((questions, scope) => questions.list(scope)),
+    "reads",
+  ),
+  t3_ask_send: McpToolAccess.asks(
+    (input) => withQuestions((questions, scope) => questions.send(scope, input)),
+    "sends",
+  ),
+  t3_ask_wait: McpToolAccess.asks(
+    (input) => withQuestions((questions, scope) => questions.wait(scope, input)),
+    "reads",
+  ),
+} satisfies McpToolAccess.Handlers<typeof AskToolkit.tools>;
+
+export const layer = McpToolAccess.toLayer(AskToolkit, handlers);
diff --git a/apps/server/src/mcp/toolkits/ask/tools.ts b/apps/server/src/mcp/toolkits/ask/tools.ts
new file mode 100644
index 0000000000000000000000000000000000000000..940f5fc8f92e4da88309b0ec21b815730232e84f
--- /dev/null
+++ b/apps/server/src/mcp/toolkits/ask/tools.ts
@@ -0,0 +1,67 @@
+import {
+  OrchestratorMcpAskListInput,
+  OrchestratorMcpAskListResult,
+  OrchestratorMcpAskSendInput,
+  OrchestratorMcpAskSendResult,
+  OrchestratorMcpAskWaitInput,
+  OrchestratorMcpAskWaitResult,
+  OrchestratorMcpFailure,
+} from "@t3tools/contracts";
+import { McpSchema, Tool, Toolkit } from "effect/ai";
+
+import * as LinkedQuestions from "../../../peer/LinkedQuestions.ts";
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+import * as ThreadManagementService from "../../../orchestration-v2/ThreadManagementService.ts";
+
+const dependencies = [
+  McpInvocationContext.McpInvocationContext,
+  ThreadManagementService.ThreadManagementService,
+  LinkedQuestions.LinkedQuestions,
+];
+
+const AskListTool = Tool.make("t3_ask_list", {
+  description:
+    "List threads on a linked machine that answer questions from linked machines. Pass that machine's environmentId from t3_environment_links. Only threads whose owner turned on Answer linked questions appear.",
+  parameters: OrchestratorMcpAskListInput,
+  success: OrchestratorMcpAskListResult,
+  failure: OrchestratorMcpFailure,
+  failureMode: "return",
+  dependencies,
+})
+  .annotate(Tool.Title, "List threads that answer linked questions")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(McpSchema.EnabledWhen, McpInvocationContext.hiddenWhileLinksOff);
+
+const AskSendTool = Tool.make("t3_ask_send", {
+  description:
+    "Ask one thread from t3_ask_list a question. It answers in text only, without tools, and may decline. One open question per thread and 10 questions per 10 minutes per link; a rate_limited error says when to try again. Then call t3_ask_wait.",
+  parameters: OrchestratorMcpAskSendInput,
+  success: OrchestratorMcpAskSendResult,
+  failure: OrchestratorMcpFailure,
+  failureMode: "return",
+  dependencies,
+})
+  .annotate(Tool.Title, "Ask a thread on a linked machine")
+  .annotate(Tool.Readonly, false)
+  .annotate(Tool.Destructive, false)
+  .annotate(McpSchema.EnabledWhen, McpInvocationContext.hiddenWhileLinksOff);
+
+const AskWaitTool = Tool.make("t3_ask_wait", {
+  description:
+    "Wait up to timeoutMs (default 30000) for the answer to a t3_ask_send question and read its text. pending: call again.",
+  parameters: OrchestratorMcpAskWaitInput,
+  success: OrchestratorMcpAskWaitResult,
+  failure: OrchestratorMcpFailure,
+  failureMode: "return",
+  dependencies,
+})
+  .annotate(Tool.Title, "Wait for a linked question's answer")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(McpSchema.EnabledWhen, McpInvocationContext.hiddenWhileLinksOff);
+
+export const AskToolkit = Toolkit.make(AskListTool, AskSendTool, AskWaitTool);
+
+/** The only tools an `ask` link may list or call. */
+export const ASK_TOOL_NAMES: ReadonlySet<string> = new Set(Object.keys(AskToolkit.tools));
