@@ -0,0 +1,135 @@
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as TestClock from "effect/testing/TestClock";
+import { HttpServerRequest } from "effect/http";
+
+import * as EnvironmentAuth from "../auth/EnvironmentAuth.ts";
+import * as ServerSecretStore from "../auth/ServerSecretStore.ts";
+import * as ServerConfig from "../config.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as Sqlite from "../persistence/Sqlite.ts";
+import * as ManagedPolicy from "../policy/ManagedPolicy.ts";
+import * as ServerSettings from "../serverSettings.ts";
+import { descriptorOf } from "./PeerLinks.testkit.ts";
+import * as InboundCap from "./inboundCap.ts";
+
+/** One run of a server over `baseDir`; a second run over the same directory is a restart. */
+const layerServerRun = (baseDir: string) =>
+  EnvironmentAuth.layer.pipe(
+    Layer.provideMerge(ServerSettings.layer),
+    Layer.provide(ManagedPolicy.layerTest()),
+    Layer.provideMerge(Sqlite.layerConfig),
+    Layer.provideMerge(ServerSecretStore.layer),
+    Layer.provideMerge(ServerEnvironment.layerIdentity),
+    Layer.provideMerge(
+      Layer.succeed(ServerEnvironment.ServerEnvironment, {
+        getEnvironmentId: Effect.succeed(descriptorOf("environment-box", "Box").environmentId),
+        getDescriptor: Effect.succeed(descriptorOf("environment-box", "Box")),
+      }),
+    ),
+    Layer.provideMerge(ServerConfig.layerTest(process.cwd(), baseDir)),
+    Layer.provideMerge(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer)),
+    Layer.fresh,
+  );
+
+const startedServer = Effect.gen(function* () {
+  const settings = yield* ServerSettings.ServerSettingsService;
+  yield* settings.start;
+  return { settings, auth: yield* EnvironmentAuth.EnvironmentAuth };
+});
+
+const issueAutoLink = EnvironmentAuth.EnvironmentAuth.pipe(
+  Effect.flatMap((auth) =>
+    auth.issueMcpClientSession({
+      label: "T3 Code · Laptop",
+      access: "auto",
+      peerLink: true,
+      client: { deviceType: "bot" },
+    }),
+  ),
+  Effect.map((issued) => issued.token),
+);
+
+const authenticate = (token: string) =>
+  InboundCap.authenticateMcpClient(
+    HttpServerRequest.fromWeb(
+      new Request("http://box.test/mcp", { headers: { authorization: `Bearer ${token}` } }),
+    ),
+  );
+
+it.effect(
+  "a link above a lowered cap stays refused after the cap is raised and the server restarts",
+  () =>
+    Effect.gen(function* () {
+      const fileSystem = yield* FileSystem.FileSystem;
+      const baseDir = yield* fileSystem.realPath(
+        yield* fileSystem.makeTempDirectoryScoped({ prefix: "t3-inbound-cap-" }),
+      );
+
+      const unusedWhileLow = yield* Effect.gen(function* () {
+        const { settings } = yield* startedServer;
+        const token = yield* issueAutoLink;
+        yield* TestClock.adjust(Duration.seconds(1));
+        yield* settings.updateSettings({ linkedEnvironmentsInboundMaxAccess: "ask" });
+        yield* settings.updateSettings({ linkedEnvironmentsInboundMaxAccess: "full-access" });
+        return token;
+      }).pipe(Effect.provide(layerServerRun(baseDir)));
+
+      yield* TestClock.adjust(Duration.seconds(1));
+      yield* Effect.gen(function* () {
+        yield* startedServer;
+        const refused = yield* authenticate(unusedWhileLow).pipe(Effect.flip);
+        expect(refused).toBeInstanceOf(InboundCap.LinkAboveInboundCapError);
+        const linkedAfterRaise = yield* issueAutoLink;
+        expect((yield* authenticate(linkedAfterRaise)).access).toBe("auto");
+      }).pipe(Effect.provide(layerServerRun(baseDir)));
+    }).pipe(Effect.provide(NodeServices.layer)),
+);
+
+const saveCapHistory = (text: string) =>
+  ServerSecretStore.ServerSecretStore.pipe(
+    Effect.flatMap((store) =>
+      store.set("linked-environments-inbound-cap-history", new TextEncoder().encode(text)),
+    ),
+  );
+
+it.effect.each([
+  "not a history",
+  "{}",
+  JSON.stringify({ bogus: Duration.toMillis(Duration.hours(1)) }),
+  JSON.stringify({ ask: Duration.toMillis(Duration.hours(1)) }),
+  JSON.stringify({ auto: Duration.toMillis(Duration.hours(1)) }),
+])("a saved cap history %s refuses only the links made before the restart", (saved) =>
+  Effect.gen(function* () {
+    const fileSystem = yield* FileSystem.FileSystem;
+    const baseDir = yield* fileSystem.realPath(
+      yield* fileSystem.makeTempDirectoryScoped({ prefix: "t3-inbound-cap-saved-" }),
+    );
+    const earlier = yield* Effect.gen(function* () {
+      yield* startedServer;
+      const token = yield* issueAutoLink;
+      yield* saveCapHistory(saved);
+      return token;
+    }).pipe(Effect.provide(layerServerRun(baseDir)));
+
+    yield* TestClock.adjust(Duration.seconds(1));
+    const afterRestart = yield* Effect.gen(function* () {
+      yield* startedServer;
+      const refused = yield* authenticate(earlier).pipe(Effect.flip);
+      expect(refused).toBeInstanceOf(InboundCap.LinkAboveInboundCapError);
+      const token = yield* issueAutoLink;
+      expect((yield* authenticate(token)).access).toBe("auto");
+      return token;
+    }).pipe(Effect.provide(layerServerRun(baseDir)));
+    yield* TestClock.adjust(Duration.seconds(1));
+    yield* Effect.gen(function* () {
+      yield* startedServer;
+      expect((yield* authenticate(afterRestart)).access).toBe("auto");
+    }).pipe(Effect.provide(layerServerRun(baseDir)));
+  }).pipe(Effect.provide(NodeServices.layer)),
+);
