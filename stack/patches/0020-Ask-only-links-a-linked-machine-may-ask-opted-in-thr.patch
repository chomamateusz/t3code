+/**
+ * A command whose input is not the payload of the protected RPC it sends; `permissionInput` is
+ * that payload as far as the permission check reads it.
+ */
+export function createGuardedEnvironmentCommand<R, ER, Input, A, E>(
+  runtime: Atom.AtomRuntime<EnvironmentRegistry.EnvironmentRegistry | R, ER>,
+  options: EnvironmentCommandAtomOptions<
+    Input,
+    A,
+    E,
+    EnvironmentSupervisor.EnvironmentSupervisor | EnvironmentRegistry.EnvironmentRegistry | R
+  > & {
+    readonly tag: EnvironmentUnaryRpcTag;
+    readonly permissionInput: unknown;
+  },
+) {
+  const permissions = createCommandPermissions(runtime, options.tag);
+  const command = createEnvironmentCommand(runtime, {
+    label: options.label,
+    ...(options.scheduler === undefined ? {} : { scheduler: options.scheduler }),
+    ...(options.concurrency === undefined ? {} : { concurrency: options.concurrency }),
+    execute: (input: Input, registry, environmentId) =>
+      permissions.authorize(registry, environmentId, options.permissionInput).pipe(
+        Effect.andThen(() => options.execute(input, registry, environmentId)),
+        Effect.provideService(RpcPermissionGuard, {
+          authorize: (id, method, payload) =>
+            createCommandPermissions(runtime, method).authorize(registry, id, payload),
+        }),
+      ),
+  });
+  return {
+    ...command,
+    permissionAtom: (environmentId: EnvironmentIdType | null) =>
+      permissions.permissionAtom(environmentId, options.permissionInput),
+  };
+}
