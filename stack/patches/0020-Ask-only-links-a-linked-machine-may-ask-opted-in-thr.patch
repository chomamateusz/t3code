+              Effect.suspend(() => {
+                if (command.type !== "thread.create") return Effect.die("not a question thread");
+                if (!accepted.has(command.commandId)) {
+                  accepted.set(command.commandId, command.threadId);
+                  created.push(command.threadId);
+                }
+                return Effect.fail(
+                  new ThreadManagement.ThreadManagementProviderInstanceDisabledError({
+                    projectId,
+                    instanceId: ProviderInstanceId.make("claude"),
+                  }),
+                );
+              }),
+          }),
+        ),
+      );
+      const asker = askLink("asker");
+      accepted.set("command:ask:asker:from-v1", threadId);
+      const replayedElsewhere = yield* questions
+        .send(asker, { threadId, question: "What is left?", clientRequestId: "from-v1" })
+        .pipe(Effect.flip);
+      expect(replayedElsewhere.code).toBe("orchestration_error");
+      for (let index = 0; index < LinkedQuestions.ASK_MAX_PER_WINDOW; index += 1) {
+        const asked = yield* questions.send(asker, {
+          threadId,
+          question: "What is left?",
+          clientRequestId: `q-${index}`,
+        });
+        expect(asked).toMatchObject({ threadId, status: "answering" });
+        expect(asked.questionId).toContain(`q-${index}`);
+      }
