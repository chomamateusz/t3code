index 0000000000000000000000000000000000000000..6339d7ad2c8989d96f0e9bffb58bdc3af59b0622
--- /dev/null
+++ b/apps/server/src/peer/LinkedQuestions.ts
@@ -0,0 +1,415 @@
+import {
+  CommandId,
+  MessageId,
+  OrchestratorMcpFailure,
+  type OrchestratorMcpAskListResult,
+  type OrchestratorMcpAskSendInput,
+  type OrchestratorMcpAskSendResult,
+  type OrchestratorMcpAskWaitInput,
+  type OrchestratorMcpAskWaitResult,
+  type OrchestrationV2LinkOrigin,
+  type OrchestrationV2Run,
+  type OrchestrationV2RunStatus,
+  type ProjectId,
+  type ThreadId,
+} from "@t3tools/contracts";
+import * as Clock from "effect/Clock";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Ref from "effect/Ref";
+import * as Semaphore from "effect/Semaphore";
+import * as SecureRandom from "effect/crypto/SecureRandom";
+
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import { callerLinkOrigin } from "../mcp/linkOrigin.ts";
+import type { McpInvocationScope } from "../mcp/McpInvocationContext.ts";
+import { LINKED_QUESTION_FAILURES } from "../orchestration-v2/linkedQuestionFailures.ts";
+import * as ProjectionStore from "../orchestration-v2/ProjectionStore.ts";
+import * as ProviderAdapterRegistry from "../orchestration-v2/ProviderAdapterRegistry.ts";
+import * as ThreadManagement from "../orchestration-v2/ThreadManagementService.ts";
+import {
+  latestRootProviderFailure,
+  usageLimitHoldsQueue,
+} from "@t3tools/shared/orchestrationV2ThreadError";
+
+const ASK_WINDOW = Duration.minutes(10);
+export const ASK_MAX_PER_WINDOW = 10;
+const ASK_MAX_ANSWER_LENGTH = 20_000;
+const ASK_DEFAULT_WAIT_MS = 30_000;
+const ASK_MAX_WAIT_MS = 45_000;
+
+const FIXED_FAILURES: ReadonlySet<string> = new Set(Object.values(LINKED_QUESTION_FAILURES));
+
+const OPEN_RUN_STATUSES = [
+  "queued",
+  "preparing",
+  "starting",
+  "running",
+  "waiting",
+] as const satisfies ReadonlyArray<OrchestrationV2RunStatus>;
+
+const isOpenQuestion = (run: OrchestrationV2Run) =>
+  run.toolless === true &&
+  (OPEN_RUN_STATUSES as ReadonlyArray<OrchestrationV2RunStatus>).includes(run.status);
+
+const failure = (code: OrchestratorMcpFailure["code"], message: string) =>
+  new OrchestratorMcpFailure({ code, message });
+
+const notLinked = failure(
+  "invalid_request",
+  "t3_ask_* answer questions from linked machines. To ask a thread on a linked machine, pass its environmentId from t3_environment_links.",
+);
+const unavailable = failure("orchestration_error", "The question could not be handled right now.");
+const noSuchThread = (threadId: ThreadId) =>
+  failure(
+    "thread_not_found",
+    `No thread here answers linked questions with id ${threadId}. List them with t3_ask_list.`,
+  );
+const noSuchQuestion = (questionId: MessageId) =>
+  failure("run_not_found", `No question ${questionId} from this link in that thread.`);
+const stillAnswering = failure(
+  "rate_limited",
+  "That thread is still answering an earlier linked question. Wait for it with t3_ask_wait, then ask again.",
+);
+const usageLimited = failure("rate_limited", LINKED_QUESTION_FAILURES.usageLimit);
+const tooManyQuestions = (retryInSeconds: number) =>
+  failure(
+    "rate_limited",
+    `This link asked ${ASK_MAX_PER_WINDOW} questions in the last 10 minutes. Try again in ${retryInSeconds} s.`,
+  );
+
+const askingLink = (scope: McpInvocationScope) =>
+  scope.client?.linked === true
+    ? Effect.succeed(callerLinkOrigin({ scope, caller: undefined }) as OrchestrationV2LinkOrigin)
+    : Effect.fail(notLinked);
+
+const questionIds = (origin: OrchestrationV2LinkOrigin, requestKey: string) => {
+  const key = [origin.sessionId, requestKey].map(encodeURIComponent).join(":");
+  return {
+    messageId: MessageId.make(`message:ask:${key}`),
+    commandId: CommandId.make(`command:ask:${key}`),
+  };
+};
+
+const continuationOf = (run: OrchestrationV2Run) =>
+  run.restartContinuationOfRunId ??
+  run.usageLimitContinuationOfRunId ??
+  run.manualContinuationOfRunId;
+
+const runChain = (runs: ReadonlyArray<OrchestrationV2Run>, head: OrchestrationV2Run) => {
+  const chain: Array<OrchestrationV2Run> = [];
+  for (const run of runs.toSorted((left, right) => left.ordinal - right.ordinal)) {
+    const continued = continuationOf(run);
+    if (
+      run.id === head.id ||
+      (continued !== undefined && chain.some((linked) => linked.id === continued))
+    ) {
+      chain.push(run);
+    }
+  }
+  return chain;
+};
+
+const truncateAnswer = (text: string) => {
+  const codePoints = Array.from(text);
+  return codePoints.length <= ASK_MAX_ANSWER_LENGTH
+    ? { answer: text }
+    : { answer: codePoints.slice(0, ASK_MAX_ANSWER_LENGTH).join(""), truncated: true };
+};
+
+export class LinkedQuestions extends Context.Service<
+  LinkedQuestions,
+  {
+    readonly list: (
+      scope: McpInvocationScope,
+    ) => Effect.Effect<OrchestratorMcpAskListResult, OrchestratorMcpFailure>;
+    readonly send: (
+      scope: McpInvocationScope,
+      input: Omit<OrchestratorMcpAskSendInput, "environmentId">,
+    ) => Effect.Effect<OrchestratorMcpAskSendResult, OrchestratorMcpFailure>;
+    readonly wait: (
+      scope: McpInvocationScope,
+      input: Omit<OrchestratorMcpAskWaitInput, "environmentId">,
+    ) => Effect.Effect<OrchestratorMcpAskWaitResult, OrchestratorMcpFailure>;
+  }
+>()("t3/peer/LinkedQuestions") {}
+
+const make = Effect.gen(function* () {
+  const threads = yield* ThreadManagement.ThreadManagementService;
+  const projections = yield* ProjectionStore.ProjectionStoreV2;
+  const environment = yield* ServerEnvironment.ServerEnvironment;
+  const providers = yield* ProviderAdapterRegistry.ProviderAdapterRegistryV2;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const random = yield* SecureRandom.SecureRandom;
+  const accepting = yield* Semaphore.make(1);
+  const askedAt = yield* Ref.make(new Map<string, ReadonlyArray<number>>());
+
+  const answeringThread = Effect.fn("LinkedQuestions.answeringThread")(function* (
+    threadId: ThreadId,
+  ) {
+    const shell = yield* threads.getThreadShell(threadId).pipe(Effect.mapError(() => unavailable));
+    if (
+      shell === null ||
+      shell.deletedAt !== null ||
+      shell.archivedAt !== null ||
+      shell.linkedQuestionsEnabledAt == null
+    ) {
+      return yield* noSuchThread(threadId);
+    }
+    return shell;
+  });
+
+  const assertAnswersWithoutTools = Effect.fn("LinkedQuestions.assertAnswersWithoutTools")(
+    function* (shell: { readonly providerInstanceId: OrchestrationV2Run["providerInstanceId"] }) {
+      const capabilities = yield* providers.get(shell.providerInstanceId).pipe(
+        Effect.flatMap((adapter) => adapter.getCapabilities()),
+        Effect.mapError(() =>
+          failure("provider_unavailable", LINKED_QUESTION_FAILURES.noToollessTurns),
+        ),
+      );
+      if (capabilities.tools.supportsToollessTurns !== true) {
+        return yield* failure("provider_unavailable", LINKED_QUESTION_FAILURES.noToollessTurns);
+      }
+    },
+  );
+
+  // A question never restores a worktree or runs setup, so a thread without its folder cannot answer.
+  const assertWorkspacePresent = Effect.fn("LinkedQuestions.assertWorkspacePresent")(function* (
+    worktreePath: string | null,
+  ) {
+    if (worktreePath === null) return;
+    const present = yield* fileSystem.exists(worktreePath).pipe(Effect.orElseSucceed(() => false));
+    if (!present) {
+      return yield* failure("thread_not_sendable", LINKED_QUESTION_FAILURES.workspaceMissing);
+    }
+  });
+
+  const assertFreeToAnswer = Effect.fn("LinkedQuestions.assertFreeToAnswer")(function* (shell: {
+    readonly projectId: ProjectId;
+    readonly id: ThreadId;
+    readonly providerInstanceId: OrchestrationV2Run["providerInstanceId"];
+  }) {
+    const records = yield* threads
+      .getProjectThreadRecords(
+        { projectId: shell.projectId, threadId: shell.id },
+        ["runs", "turnItems", "providerSessions"],
+        { turnItemTypes: ["error"] },
+      )
+      .pipe(Effect.mapError(() => unavailable));
+    if (records.runs.some(isOpenQuestion)) {
+      return yield* stillAnswering;
+    }
+    if (usageLimitHoldsQueue(records, shell.providerInstanceId, yield* DateTime.now)) {
+      return yield* usageLimited;
+    }
+  });
+
+  const recentQuestions = Effect.fn("LinkedQuestions.recentQuestions")(function* (
+    sessionId: string,
+  ) {
+    const now = yield* Clock.currentTimeMillis;
+    const windowStart = now - Duration.toMillis(ASK_WINDOW);
+    const recent = ((yield* Ref.get(askedAt)).get(sessionId) ?? []).filter(
+      (at) => at > windowStart,
+    );
+    return { now, recent };
+  });
+
+  const list = Effect.fn("LinkedQuestions.list")(function* (scope: McpInvocationScope) {
+    yield* askingLink(scope);
+    const machine = (yield* environment.getDescriptor).label;
+    const listed = yield* projections
+      .listLinkedQuestionThreads()
+      .pipe(Effect.mapError(() => unavailable));
+    return {
+      environmentId: scope.environmentId,
+      machine,
+      threads: listed.map((thread) => ({
+        threadId: thread.threadId,
+        title: thread.title,
+        machine,
+      })),
+    } satisfies OrchestratorMcpAskListResult;
+  });
+
+  const send = Effect.fn("LinkedQuestions.send")(function* (
+    scope: McpInvocationScope,
+    input: Omit<OrchestratorMcpAskSendInput, "environmentId">,
+  ) {
+    const origin = yield* askingLink(scope);
+    const requestKey = input.clientRequestId ?? (yield* random.uuidV4());
+    const { messageId, commandId } = questionIds(origin, requestKey);
+    const answered = (status: "answering" | "queued") =>
+      ({
+        environmentId: scope.environmentId,
+        threadId: input.threadId,
+        questionId: messageId,
+        status,
+      }) satisfies OrchestratorMcpAskSendResult;
+    return yield* accepting.withPermits(1)(
