+  const failureOf = Effect.fn("LinkedQuestions.failureOf")(function* (
+    projectId: ProjectId,
+    threadId: ThreadId,
+    lastRun: OrchestrationV2Run,
+  ) {
+    const { turnItems } = yield* threads
+      .getProjectThreadRecords({ projectId, threadId }, ["turnItems"], {
+        turnItemTypes: ["error"],
+        turnItemRunIds: [lastRun.id],
+      })
+      .pipe(Effect.orElseSucceed(() => ({ turnItems: [] })));
