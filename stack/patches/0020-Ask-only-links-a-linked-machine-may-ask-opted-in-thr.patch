index 0000000000000000000000000000000000000000..b5039c95fcd29d969b94d3ac52b4ee019c33ed84
--- /dev/null
+++ b/apps/server/src/peer/LinkedQuestions.ts
@@ -0,0 +1,391 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- A synchronous digest inside a pure id derivation.
+import * as NodeCrypto from "node:crypto";
+
+import {
+  CommandId,
+  MessageId,
+  OrchestratorMcpFailure,
+  type OrchestratorMcpAskListResult,
+  type OrchestratorMcpAskSendInput,
+  type OrchestratorMcpAskSendResult,
+  type OrchestratorMcpAskWaitInput,
+  type OrchestratorMcpAskWaitResult,
+  type OrchestrationV2Command,
+  type OrchestrationV2LinkOrigin,
+  type OrchestrationV2Run,
+  type OrchestrationV2ThreadShell,
+  type ProjectId,
+  ThreadId,
+} from "@t3tools/contracts";
+import * as Clock from "effect/Clock";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as Ref from "effect/Ref";
+import * as Semaphore from "effect/Semaphore";
+import * as SecureRandom from "effect/crypto/SecureRandom";
+
+import * as ServerConfig from "../config.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import { callerLinkOrigin } from "../mcp/linkOrigin.ts";
+import type { McpInvocationScope } from "../mcp/McpInvocationContext.ts";
+import {
+  answersLinkedQuestions,
+  LINKED_QUESTION_FAILURES,
+} from "../orchestration-v2/linkedQuestionFailures.ts";
+import * as ProjectionStore from "../orchestration-v2/ProjectionStore.ts";
+import * as ProviderAdapterRegistry from "../orchestration-v2/ProviderAdapterRegistry.ts";
+import * as ThreadManagement from "../orchestration-v2/ThreadManagementService.ts";
+import { withoutWebhookUrlToken } from "../scheduledTasks/webhookUrlToken.ts";
+import { latestRootProviderFailure } from "@t3tools/shared/orchestrationV2ThreadError";
+
+const ASK_WINDOW = Duration.minutes(10);
+export const ASK_MAX_PER_WINDOW = 10;
+export const ASK_MAX_UNARCHIVED_QUESTIONS = 20;
+const ASK_MAX_ANSWER_LENGTH = 20_000;
+const ASK_DEFAULT_WAIT_MS = 30_000;
+const ASK_MAX_WAIT_MS = 45_000;
+const QUESTION_TITLE_MAX_CODE_POINTS = 80;
+const QUESTION_MESSAGE_PREFIX = "message:ask:";
+
+const FIXED_FAILURES: ReadonlySet<string> = new Set(Object.values(LINKED_QUESTION_FAILURES));
+
+const failure = (code: OrchestratorMcpFailure["code"], message: string) =>
+  new OrchestratorMcpFailure({ code, message });
+
+const notLinked = failure(
+  "invalid_request",
+  "t3_ask_* answer questions from linked machines. To ask a thread on a linked machine, pass its environmentId from t3_environment_links.",
+);
+const unavailable = failure("orchestration_error", "The question could not be handled right now.");
+const noSuchThread = (threadId: ThreadId) =>
+  failure(
+    "thread_not_found",
+    `No thread here answers linked questions with id ${threadId}. List them with t3_ask_list.`,
+  );
+const noSuchQuestion = (questionId: MessageId) =>
+  failure("run_not_found", `No question ${questionId} from this link in that thread.`);
+const stillAnswering = failure(
+  "rate_limited",
+  "That thread is still answering an earlier linked question. Wait for it with t3_ask_wait, then ask again.",
+);
+const reusedRequestId = failure(
+  "invalid_request",
+  "That clientRequestId already asked another thread. Use a new clientRequestId for a new question.",
+);
+const tooManyUnarchived = failure(
+  "rate_limited",
+  `That thread already has ${ASK_MAX_UNARCHIVED_QUESTIONS} answered linked questions its owner has not archived. Ask again later.`,
+);
+const tooManyQuestions = (retryInSeconds: number) =>
+  failure(
+    "rate_limited",
+    `This link asked ${ASK_MAX_PER_WINDOW} questions in the last 10 minutes. Try again in ${retryInSeconds} s.`,
+  );
+
+const askingLink = (scope: McpInvocationScope) =>
+  scope.client?.linked === true
+    ? Effect.succeed(callerLinkOrigin({ scope, caller: undefined }) as OrchestrationV2LinkOrigin)
+    : Effect.fail(notLinked);
+
+const questionKeyPrefix = (origin: OrchestrationV2LinkOrigin) =>
+  `${encodeURIComponent(origin.sessionId)}:`;
+
+// A thread id ends up in file and URL paths, so it carries a digest of the key, never the key.
+const questionThreadId = (key: string) =>
+  ThreadId.make(`ask-${NodeCrypto.createHash("sha256").update(key).digest("hex").slice(0, 32)}`);
+
+const questionIds = (origin: OrchestrationV2LinkOrigin, requestKey: string) => {
+  const key = `${questionKeyPrefix(origin)}${encodeURIComponent(requestKey)}`;
+  return {
+    messageId: MessageId.make(`${QUESTION_MESSAGE_PREFIX}${key}`),
+    commandId: CommandId.make(`command:ask:${key}`),
+    threadId: questionThreadId(key),
+  };
+};
+
+const askedBy = (origin: OrchestrationV2LinkOrigin, questionId: MessageId) =>
+  questionId.startsWith(`${QUESTION_MESSAGE_PREFIX}${questionKeyPrefix(origin)}`);
+
+const questionTitle = (question: string) =>
+  Array.from(question.replace(/\s+/g, " ").trim())
+    .slice(0, QUESTION_TITLE_MAX_CODE_POINTS)
+    .join("")
+    .trim() || "Linked question";
+
+export const makeQuestionThreadCreate = (input: {
+  readonly commandId: CommandId;
+  readonly threadId: ThreadId;
+  readonly messageId: MessageId;
+  readonly asked: Pick<OrchestrationV2ThreadShell, "id" | "projectId" | "modelSelection">;
+  readonly question: string;
+  readonly folder: string;
+  readonly origin: OrchestrationV2LinkOrigin;
+}): Extract<OrchestrationV2Command, { readonly type: "thread.create" }> => ({
+  type: "thread.create",
+  commandId: input.commandId,
+  threadId: input.threadId,
+  projectId: input.asked.projectId,
+  title: questionTitle(input.question),
+  titleRenamed: true,
+  modelSelection: input.asked.modelSelection,
+  runtimeMode: "approval-required",
+  interactionMode: "default",
+  branch: null,
+  worktreePath: input.folder,
+  linkOrigin: input.origin,
+  linkedQuestionOf: input.asked.id,
+  createdBy: "agent",
+  creationSource: "mcp",
+  initialMessage: { messageId: input.messageId, text: input.question, attachments: [] },
+});
+
+const truncateAnswer = (text: string) => {
+  const codePoints = Array.from(text);
+  return codePoints.length <= ASK_MAX_ANSWER_LENGTH
+    ? { answer: text }
+    : { answer: codePoints.slice(0, ASK_MAX_ANSWER_LENGTH).join(""), truncated: true };
+};
+
+export class LinkedQuestions extends Context.Service<
+  LinkedQuestions,
+  {
+    readonly list: (
+      scope: McpInvocationScope,
+    ) => Effect.Effect<OrchestratorMcpAskListResult, OrchestratorMcpFailure>;
+    readonly send: (
+      scope: McpInvocationScope,
+      input: Omit<OrchestratorMcpAskSendInput, "environmentId">,
+    ) => Effect.Effect<OrchestratorMcpAskSendResult, OrchestratorMcpFailure>;
+    readonly wait: (
+      scope: McpInvocationScope,
+      input: Omit<OrchestratorMcpAskWaitInput, "environmentId">,
+    ) => Effect.Effect<OrchestratorMcpAskWaitResult, OrchestratorMcpFailure>;
+  }
+>()("t3/peer/LinkedQuestions") {}
+
+const make = Effect.gen(function* () {
+  const threads = yield* ThreadManagement.ThreadManagementService;
+  const projections = yield* ProjectionStore.ProjectionStoreV2;
+  const environment = yield* ServerEnvironment.ServerEnvironment;
+  const providers = yield* ProviderAdapterRegistry.ProviderAdapterRegistryV2;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const random = yield* SecureRandom.SecureRandom;
+  const accepting = yield* Semaphore.make(1);
+  const askedAt = yield* Ref.make(new Map<string, ReadonlyArray<number>>());
+  const questionsFolder = (yield* Path.Path).join(
+    (yield* ServerConfig.ServerConfig).baseDir,
+    "linked-questions",
+  );
+
+  const answeringThread = Effect.fn("LinkedQuestions.answeringThread")(function* (
+    threadId: ThreadId,
+  ) {
+    const shell = yield* threads.getThreadShell(threadId).pipe(Effect.mapError(() => unavailable));
+    if (!answersLinkedQuestions(shell)) return yield* noSuchThread(threadId);
+    return shell;
+  });
+
+  const assertAnswersWithoutTools = Effect.fn("LinkedQuestions.assertAnswersWithoutTools")(
+    function* (shell: { readonly providerInstanceId: OrchestrationV2Run["providerInstanceId"] }) {
+      const capabilities = yield* providers.get(shell.providerInstanceId).pipe(
+        Effect.flatMap((adapter) => adapter.getCapabilities()),
+        Effect.mapError(() =>
+          failure("provider_unavailable", LINKED_QUESTION_FAILURES.noToollessTurns),
+        ),
+      );
+      if (capabilities.tools.supportsToollessTurns !== true) {
+        return yield* failure("provider_unavailable", LINKED_QUESTION_FAILURES.noToollessTurns);
+      }
+    },
+  );
+
+  const recentQuestions = Effect.fn("LinkedQuestions.recentQuestions")(function* (
+    sessionId: string,
+  ) {
+    const now = yield* Clock.currentTimeMillis;
+    const windowStart = now - Duration.toMillis(ASK_WINDOW);
+    const recent = ((yield* Ref.get(askedAt)).get(sessionId) ?? []).filter(
+      (at) => at > windowStart,
+    );
+    return { now, recent };
+  });
+
+  const list = Effect.fn("LinkedQuestions.list")(function* (scope: McpInvocationScope) {
+    yield* askingLink(scope);
+    const machine = (yield* environment.getDescriptor).label;
+    const listed = yield* projections
+      .listLinkedQuestionThreads()
+      .pipe(Effect.mapError(() => unavailable));
+    return {
+      environmentId: scope.environmentId,
+      machine,
+      threads: listed.map((thread) => ({
+        threadId: thread.threadId,
+        title: withoutWebhookUrlToken(thread.title),
+        machine,
+      })),
+    } satisfies OrchestratorMcpAskListResult;
+  });
+
+  const send = Effect.fn("LinkedQuestions.send")(function* (
+    scope: McpInvocationScope,
+    input: Omit<OrchestratorMcpAskSendInput, "environmentId">,
+  ) {
+    const origin = yield* askingLink(scope);
+    const requestKey = input.clientRequestId ?? (yield* random.uuidV4());
+    const ids = questionIds(origin, requestKey);
+    const answering = {
+      environmentId: scope.environmentId,
+      threadId: input.threadId,
+      questionId: ids.messageId,
+      status: "answering",
+    } satisfies OrchestratorMcpAskSendResult;
+    return yield* accepting.withPermits(1)(
+      Effect.gen(function* () {
+        const asked = yield* answeringThread(input.threadId);
+        if (yield* threads.hasAcceptedReceipt(ids.commandId, ids.threadId)) {
+          const earlier = yield* threads
+            .getThreadShell(ids.threadId)
+            .pipe(Effect.mapError(() => unavailable));
+          if (earlier?.linkedQuestionOf !== input.threadId) return yield* reusedRequestId;
+          return answering;
+        }
+        yield* assertAnswersWithoutTools(asked);
+        yield* threads
+          .assertProviderInstanceEnabled({
+            projectId: asked.projectId,
+            commandId: ids.commandId,
+            instanceId: asked.modelSelection.instanceId,
+          })
+          .pipe(Effect.mapError(() => unavailable));
+        const load = yield* projections
+          .getLinkedQuestionLoad(asked.id)
+          .pipe(Effect.mapError(() => unavailable));
+        if (load.answering > 0) return yield* stillAnswering;
+        if (load.unarchived >= ASK_MAX_UNARCHIVED_QUESTIONS) return yield* tooManyUnarchived;
+        const { now, recent } = yield* recentQuestions(origin.sessionId);
+        if (recent.length >= ASK_MAX_PER_WINDOW) {
+          const oldest = Math.min(...recent);
+          return yield* tooManyQuestions(
+            Math.max(1, Math.ceil((oldest + Duration.toMillis(ASK_WINDOW) - now) / 1000)),
+          );
+        }
+        yield* fileSystem
+          .makeDirectory(questionsFolder, { recursive: true })
+          .pipe(Effect.mapError(() => unavailable));
+        yield* threads
+          .dispatch(
+            makeQuestionThreadCreate({
+              ...ids,
+              asked,
+              question: input.question,
+              folder: questionsFolder,
+              origin,
+            }),
+          )
+          .pipe(Effect.ignore);
+        // A receipt replayed for another thread under the same command id created nothing here.
+        if (!(yield* threads.hasAcceptedReceipt(ids.commandId, ids.threadId))) {
+          return yield* unavailable;
+        }
+        yield* Ref.update(askedAt, (askedBySession) =>
+          new Map(askedBySession).set(origin.sessionId, [...recent, now]),
+        );
+        return answering;
+      }),
+    );
+  });
+
+  const answerOf = Effect.fn("LinkedQuestions.answerOf")(function* (
+    projectId: ProjectId,
+    threadId: ThreadId,
+    run: OrchestrationV2Run,
+  ) {
+    const { messages } = yield* threads
+      .getProjectThreadRecords({ projectId, threadId }, ["messages"], {
+        messageRunIds: [run.id],
+        messageRoles: ["assistant"],
+      })
+      .pipe(Effect.mapError(() => unavailable));
+    const text = messages
+      .filter((message) => message.role === "assistant" && message.text.trim() !== "")
+      .toSorted(
+        (left, right) =>
+          DateTime.toEpochMillis(left.createdAt) - DateTime.toEpochMillis(right.createdAt),
+      )
+      .map((message) => message.text)
+      .join("\n\n");
+    return truncateAnswer(withoutWebhookUrlToken(text));
+  });
+
+  const failureOf = Effect.fn("LinkedQuestions.failureOf")(function* (
+    projectId: ProjectId,
+    threadId: ThreadId,
+    lastRun: OrchestrationV2Run,
+  ) {
+    const { turnItems } = yield* threads
+      .getProjectThreadRecords({ projectId, threadId }, ["turnItems"], {
+        turnItemTypes: ["error"],
+        turnItemRunIds: [lastRun.id],
+      })
+      .pipe(Effect.orElseSucceed(() => ({ turnItems: [] })));
+    const message = latestRootProviderFailure(lastRun, turnItems)?.message;
+    return message !== undefined && FIXED_FAILURES.has(message)
+      ? message
+      : LINKED_QUESTION_FAILURES.stopped;
+  });
+
+  const wait = Effect.fn("LinkedQuestions.wait")(function* (
+    scope: McpInvocationScope,
+    input: Omit<OrchestratorMcpAskWaitInput, "environmentId">,
+  ) {
+    const origin = yield* askingLink(scope);
+    const missing = noSuchQuestion(input.questionId);
+    if (!askedBy(origin, input.questionId)) return yield* missing;
+    const questionThread = yield* threads
+      .getThreadShell(questionThreadId(input.questionId.slice(QUESTION_MESSAGE_PREFIX.length)))
+      .pipe(Effect.mapError(() => unavailable));
+    if (
+      questionThread === null ||
+      questionThread.deletedAt !== null ||
+      questionThread.linkedQuestionOf !== input.threadId ||
+      questionThread.linkOrigin?.sessionId !== origin.sessionId
+    ) {
+      return yield* missing;
+    }
+    const thread = { projectId: questionThread.projectId, threadId: questionThread.id };
+    const goneOr = (cause: { readonly _tag: string }) =>
+      cause._tag === "ThreadManagementThreadNotFoundError" ? missing : unavailable;
+    const { runs } = yield* threads
+      .getProjectThreadRecords(thread, ["runs"])
+      .pipe(Effect.mapError(goneOr));
+    const question = runs.find((run) => run.userMessageId === input.questionId);
+    if (question === undefined) return yield* missing;
+    const timeoutMs = Math.min(ASK_MAX_WAIT_MS, input.timeoutMs ?? ASK_DEFAULT_WAIT_MS);
+    const waited = yield* threads
+      .waitForThread({ ...thread, runId: question.id, timeoutMs })
+      .pipe(Effect.mapError(goneOr));
+    if (waited.timedOut || waited.run === null) {
+      return { status: "pending" } satisfies OrchestratorMcpAskWaitResult;
+    }
+    if (waited.run.status === "completed") {
+      return {
+        status: "answered",
+        ...(yield* answerOf(thread.projectId, thread.threadId, waited.run)),
+      } satisfies OrchestratorMcpAskWaitResult;
+    }
+    return {
+      status: "failed",
+      error: yield* failureOf(thread.projectId, thread.threadId, waited.run),
+    } satisfies OrchestratorMcpAskWaitResult;
+  });
+
+  return LinkedQuestions.of({ list, send, wait });
+});
+
+export const layer = Layer.effect(LinkedQuestions, make);
