diff --git a/apps/server/src/orchestration-v2/linkedQuestionFailures.ts b/apps/server/src/orchestration-v2/linkedQuestionFailures.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bccf0d9fb40ab374722a4979e0d98f23035dffb6
--- /dev/null
+++ b/apps/server/src/orchestration-v2/linkedQuestionFailures.ts
@@ -0,0 +1,114 @@
+import type { OrchestrationV2Run, OrchestrationV2ThreadShell, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import type { ProjectionStoreV2Shape } from "./ProjectionStore.ts";
+import type { ProviderAdapterRegistryV2Shape } from "./ProviderAdapterRegistry.ts";
+
+/** The only failure texts an asking machine reads about a question: none carries this machine's details. */
+export const LINKED_QUESTION_FAILURES = {
+  optedOut: "This thread's owner turned off Answer linked questions before it answered.",
+  noToollessTurns:
+    "This thread's provider cannot answer without tools, so it does not take linked questions.",
+  stopped: "The thread stopped before answering.",
+  usageLimit: "The thread hit its usage limit before answering. Ask again later.",
+} as const;
+
+export class LinkedQuestionStartRefusedError extends Schema.TaggedError<LinkedQuestionStartRefusedError>()(
+  "LinkedQuestionStartRefusedError",
+  { reason: Schema.Literals(["optedOut", "noToollessTurns"]) },
+) {
+  override get message(): string {
+    return LINKED_QUESTION_FAILURES[this.reason];
+  }
+}
+
+export const isLinkedQuestionStartRefusedError = Schema.is(LinkedQuestionStartRefusedError);
+
+export const answersLinkedQuestions = <
+  Thread extends Pick<
+    OrchestrationV2ThreadShell,
+    "deletedAt" | "archivedAt" | "linkedQuestionsEnabledAt"
+  >,
+>(
+  thread: Thread | null,
+): thread is Thread =>
+  thread !== null &&
+  thread.deletedAt === null &&
+  thread.archivedAt === null &&
+  thread.linkedQuestionsEnabledAt != null;
+
+export const assertAskedThreadAnswers = (
+  projectionStore: Pick<ProjectionStoreV2Shape, "getThreadShell">,
+  askedThreadId: ThreadId,
+) =>
+  projectionStore
+    .getThreadShell(askedThreadId)
+    .pipe(
+      Effect.filterOrFail(
+        answersLinkedQuestions,
+        () => new LinkedQuestionStartRefusedError({ reason: "optedOut" }),
+      ),
+    );
+
+class LinkedQuestionOutsideItsThreadError extends Schema.TaggedError<LinkedQuestionOutsideItsThreadError>()(
+  "LinkedQuestionOutsideItsThreadError",
+  {},
+) {
+  override get message(): string {
+    return "A tool-less run starts only in a linked question's own thread.";
+  }
+}
+
+const START_REFUSAL_TITLES = {
+  optedOut: "Thread no longer answers linked questions",
+  noToollessTurns: "Provider cannot answer without tools",
+} as const satisfies Record<LinkedQuestionStartRefusedError["reason"], string>;
+
+export const linkedQuestionStartFailure = (reason: LinkedQuestionStartRefusedError["reason"]) => {
+  const error = new LinkedQuestionStartRefusedError({ reason });
+  return {
+    signal: `linked-question-${reason}`,
+    title: START_REFUSAL_TITLES[reason],
+    error,
+    message: error.message,
+  };
+};
+
+export const linkedQuestionContextFailure = (error: Error) => ({
+  signal: "linked-question-context-read-failure",
+  title: "Couldn't read the thread a linked question asked",
+  error,
+  message: LINKED_QUESTION_FAILURES.stopped,
+});
+
+export const linkedQuestionStartRefusal = Effect.fn("linkedQuestionStartRefusal")(
+  function* (input: {
+    readonly run: Pick<OrchestrationV2Run, "toolless" | "modelSelection">;
+    readonly askedThreadId: ThreadId | undefined;
+    readonly projectionStore: Pick<ProjectionStoreV2Shape, "getThreadShell">;
+    readonly providerAdapters: Pick<ProviderAdapterRegistryV2Shape, "get">;
+  }) {
+    if (input.askedThreadId === undefined) {
+      return input.run.toolless === true
+        ? {
+            signal: "linked-question-outside-question-thread",
+            title: "Linked question outside its own thread",
+            error: new LinkedQuestionOutsideItsThreadError(),
+            message: LINKED_QUESTION_FAILURES.stopped,
+          }
+        : undefined;
+    }
+    if (!answersLinkedQuestions(yield* input.projectionStore.getThreadShell(input.askedThreadId))) {
+      return linkedQuestionStartFailure("optedOut");
+    }
+    const answersWithoutTools = yield* input.providerAdapters
+      .get(input.run.modelSelection.instanceId)
+      .pipe(
+        Effect.flatMap((adapter) => adapter.getCapabilities()),
+        Effect.map((capabilities) => capabilities.tools.supportsToollessTurns === true),
+        Effect.orElseSucceed(() => false),
+      );
+    return answersWithoutTools ? undefined : linkedQuestionStartFailure("noToollessTurns");
+  },
+);
