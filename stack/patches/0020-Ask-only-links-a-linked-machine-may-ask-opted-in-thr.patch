+/** The smallest arguments a tool's input schema accepts, so a call reaches its handler. */
+const minimalArguments = (schema: unknown): unknown => {
+  if (typeof schema !== "object" || schema === null) return {};
+  const node = schema as Record<string, unknown>;
+  if ("const" in node) return node.const;
+  if (Array.isArray(node.enum)) return node.enum[0];
+  if (Array.isArray(node.allOf)) return minimalArguments(Object.assign({}, ...node.allOf));
+  const branches = (node.anyOf ?? node.oneOf) as ReadonlyArray<unknown> | undefined;
+  if (branches !== undefined) return minimalArguments(branches[0]);
+  const type = Array.isArray(node.type) ? node.type[0] : node.type;
+  switch (type) {
+    case "string":
+      return "x".repeat(typeof node.minLength === "number" ? Math.max(2, node.minLength) : 2);
+    case "integer":
+    case "number":
+      return typeof node.minimum === "number" ? node.minimum : 1;
+    case "boolean":
+      return false;
+    case "null":
+      return null;
+    case "array":
+      return Array.from({ length: typeof node.minItems === "number" ? node.minItems : 0 }, () =>
+        minimalArguments(node.items),
+      );
+    default: {
+      const properties = (node.properties ?? {}) as Record<string, unknown>;
+      const required = (node.required ?? []) as ReadonlyArray<string>;
+      return Object.fromEntries(required.map((key) => [key, minimalArguments(properties[key])]));
+    }
+  }
+};
