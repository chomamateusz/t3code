+++ b/apps/server/src/peer/inboundCap.ts
@@ -0,0 +1,93 @@
+import { type AuthMcpClientAccess, isMcpClientAccessAbove } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import { type HttpServerRequest, HttpServerResponse } from "effect/http";
+
+import * as EnvironmentAuth from "../auth/EnvironmentAuth.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as ServerSettings from "../serverSettings.ts";
+
+const ACCESS_LABELS = {
+  ask: "Ask only",
+  "read-only": "Read only",
+  "approval-required": "Supervised",
+  "auto-accept-edits": "Auto-accept edits",
+  auto: "Auto",
+  "full-access": "Full access",
+} as const satisfies Record<AuthMcpClientAccess, string>;
+
+export const LINK_ABOVE_INBOUND_CAP = "link_above_inbound_cap";
+
+/** How soon a link's open stream ends after the link is revoked here or falls above the cap. */
+export const ACCESS_RECHECK_INTERVAL = Duration.seconds(30);
+
+/** A link session used here above this machine's inbound cap; the request that found it revoked it. */
+export class LinkAboveInboundCapError extends Schema.TaggedError<LinkAboveInboundCapError>()(
+  "LinkAboveInboundCapError",
+  { message: Schema.String },
+) {}
+
+/** Why a link at `access` may not be approved here, or undefined when the cap admits it. */
+export const approvalAboveInboundCap = (
+  cap: AuthMcpClientAccess,
+  access: AuthMcpClientAccess,
+  machine: string,
+): string | undefined =>
+  isMcpClientAccessAbove(access, cap)
+    ? `${machine} accepts links with at most ${ACCESS_LABELS[cap]} access. Link again with ${ACCESS_LABELS[cap]} access or lower.`
+    : undefined;
+
+export const linkAboveInboundCapResponse = (message: string) =>
+  HttpServerResponse.jsonUnsafe(
+    { error: LINK_ABOVE_INBOUND_CAP, message },
+    { status: 403, headers: { "cache-control": "no-store" } },
+  );
+
+/**
+ * Authenticates an MCP client as every route a link's token reaches does. A link above the inbound
+ * cap, now or at any time since it was linked, is revoked, so raising the cap never brings it back.
+ */
+export const authenticateMcpClient = Effect.fn("PeerInboundCap.authenticateMcpClient")(function* (
+  request: HttpServerRequest.HttpServerRequest,
+) {
+  const auth = yield* EnvironmentAuth.EnvironmentAuth;
+  const client = yield* auth.authenticateMcpClient(request);
+  if (!client.peerLink) return client;
+  const settingsService = yield* ServerSettings.ServerSettingsService;
+  const settings = yield* settingsService.getSettings.pipe(
+    Effect.mapError(
+      (cause) =>
+        new EnvironmentAuth.ServerAuthInvalidCredentialError({
+          cause,
+          diagnostic: "The inbound link cap could not be read.",
+        }),
+    ),
+  );
+  const cap = settings.linkedEnvironmentsInboundMaxAccess;
+  const aboveCap = isMcpClientAccessAbove(client.access, cap);
+  const lastAboveCapAt = yield* settingsService.lastAboveInboundCapAt(client.access);
+  const aboveCapSinceLinked =
+    lastAboveCapAt !== undefined &&
+    client.issuedAt !== undefined &&
+    DateTime.toEpochMillis(client.issuedAt) < lastAboveCapAt;
+  if (!aboveCap && !aboveCapSinceLinked) return client;
+  const machine = (yield* (yield* ServerEnvironment.ServerEnvironment).getDescriptor).label;
+  yield* auth
+    .revokeSession(client.sessionId)
+    .pipe(
+      Effect.catch((cause) =>
+        Effect.logError("Could not revoke a link above the inbound cap.", { cause }),
+      ),
+    );
+  yield* Effect.logInfo("Revoked a link above the inbound cap.", {
+    access: client.access,
+    cap,
+  });
+  return yield* new LinkAboveInboundCapError({
+    message: aboveCap
+      ? `${machine} now accepts links with at most ${ACCESS_LABELS[cap]} access, and this link has ${ACCESS_LABELS[client.access]}. It stops working until it is linked again with ${ACCESS_LABELS[cap]} access or lower.`
+      : `${machine} accepted less than this link's ${ACCESS_LABELS[client.access]} access after it was linked. It stops working until it is linked again.`,
+  });
+});
