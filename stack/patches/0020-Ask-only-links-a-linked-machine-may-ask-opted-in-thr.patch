+            createdBy: "agent",
+            creationSource: "mcp",
+          })
+          .pipe(Effect.mapError(() => unavailable));
+        if (!replay) {
+          const { now, recent } = yield* recentQuestions(origin.sessionId);
+          yield* Ref.update(askedAt, (asked) =>
+            new Map(asked).set(origin.sessionId, [...recent, now]),
+          );
