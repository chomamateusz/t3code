+        .send(asker, { threadId, question: "What is left?", clientRequestId: "one-more" })
+        .pipe(Effect.flip);
+      expect(limited.code).toBe("rate_limited");
+      expect(created).toHaveLength(LinkedQuestions.ASK_MAX_PER_WINDOW);
+      expect(created.every((id) => /^ask-[0-9a-f]{32}$/.test(id))).toBe(true);
+    }),
+);
