+
+describe("closeRemoteTerminalSession", () => {
+  it("keeps a close until its environment takes it", async () => {
+    useTerminalUiStateStore.setState({ pendingRemoteCloses: [] });
+    Object.assign(state, { canOperate: false, closeFails: false, closes: 0 });
+
+    await closeRemoteTerminalSession(target);
+    await closeRemoteTerminalSession(target);
+    expect(pending()).toEqual([target]);
+    expect(state.closes).toBe(0);
+
+    state.canOperate = true;
+    state.closeFails = true;
+    const sending = closeRemoteTerminalSession(target);
+    // Recorded before the request settles, so a reload mid-close still retries it.
+    expect(pending()).toEqual([target]);
+    await sending;
+
+    expect(pending()).toEqual([target]);
+
+    state.closeFails = false;
+    await closeRemoteTerminalSession(target);
+    expect(pending()).toEqual([]);
+    expect(state.closes).toBe(2);
+  });
+
+  it("closes every remote terminal of a thread and only that thread", () => {
+    resetStore();
+    const store = useTerminalUiStateStore.getState();
+    store.newTerminal(thread, "term-remote", remote);
+    store.newTerminal(thread, "term-local");
+    store.newTerminal(thread, "term-split", remote);
+    store.newTerminal(otherThread, "term-other", remote);
+
+    closeThreadRemoteTerminals(thread);
+
+    expect(pending()).toEqual([
+      { environmentId: remote.environmentId, threadId: thread.threadId, terminalId: "term-remote" },
+      { environmentId: remote.environmentId, threadId: thread.threadId, terminalId: "term-split" },
+    ]);
+    expect(terminalIds(thread)).not.toContain("term-remote");
+    expect(terminalIds(thread)).not.toContain("term-split");
+    expect(terminalIds(thread)).toContain("term-local");
+    expect(terminalIds(otherThread)).toContain("term-other");
+    expect(remoteTerminals(thread)).toEqual({});
+    expect(remoteTerminals(otherThread)).toEqual({ "term-other": remote });
+  });
+
+  it("closes the session of a tab whose open failed before dropping the tab", () => {
+    resetStore();
+    useTerminalUiStateStore.getState().newTerminal(thread, target.terminalId, remote);
+
+    closeRemoteTerminalTab(thread, target.environmentId, target.terminalId);
+
+    expect(pending()).toEqual([target]);
+    expect(terminalIds(thread)).not.toContain(target.terminalId);
+  });
+});
