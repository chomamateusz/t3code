+vi.mock("@t3tools/client-runtime/state/runtime", () => ({
+  runAtomCommand: async () => {
+    state.closes += 1;
+    return state.closeFails
+      ? AsyncResult.failure(Cause.fail(new Error("unreachable")))
+      : AsyncResult.success(undefined);
+  },
+}));
+
+const target = {
+  environmentId: EnvironmentId.make("environment-laptop"),
+  threadId: "thread-1",
+  terminalId: "term-2-abc",
+};
+const pending = () => useTerminalUiStateStore.getState().pendingRemoteCloses;
+const thread = scopeThreadRef(EnvironmentId.make("environment-desktop"), ThreadId.make("thread-1"));
+const otherThread = scopeThreadRef(thread.environmentId, ThreadId.make("thread-2"));
+const remote = { environmentId: target.environmentId, cwd: "/home/remote" };
+const terminalIds = (ref: typeof thread) =>
+  selectThreadTerminalUiState(useTerminalUiStateStore.getState().terminalUiStateByThreadKey, ref)
+    .terminalIds;
+const remoteTerminals = (ref: typeof thread) =>
+  selectThreadRemoteTerminals(useTerminalUiStateStore.getState().remoteTerminalsByThreadKey, ref);
+
+function resetStore() {
+  useTerminalUiStateStore.setState(useTerminalUiStateStore.getInitialState(), true);
+  Object.assign(state, { canOperate: false, closeFails: false, closes: 0 });
