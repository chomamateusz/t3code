@@ -0,0 +1,68 @@
+import {
+  AuthTerminalOperateScope,
+  type EnvironmentId,
+  type ScopedThreadRef,
+} from "@t3tools/contracts";
+import { runAtomCommand } from "@t3tools/client-runtime/state/runtime";
+
+import { appAtomRegistry } from "../../rpc/atomRegistry";
+import { readEnvironmentScope } from "../../state/session";
+import { terminalEnvironment } from "../../state/terminal";
+import {
+  type PendingRemoteClose,
+  selectThreadRemoteTerminals,
+  useTerminalUiStateStore,
+} from "../../terminalUiStateStore";
+
+const inFlight = new Set<string>();
+
+/**
+ * Closes a terminal this client opened on another environment. The close is recorded before it
+ * is sent and forgotten only once it lands, so a reload, an offline machine or a failed request
+ * leaves it queued for `RemoteTerminalCloseCoordinator`: nothing else would ever end that shell.
+ */
+export async function closeRemoteTerminalSession(target: PendingRemoteClose): Promise<void> {
+  const store = useTerminalUiStateStore.getState();
+  store.queueRemoteClose(target);
+  const key = JSON.stringify([target.environmentId, target.threadId, target.terminalId]);
+  if (inFlight.has(key) || !readEnvironmentScope(target.environmentId, AuthTerminalOperateScope)) {
+    return;
+  }
+  inFlight.add(key);
+  try {
+    const result = await runAtomCommand(
+      appAtomRegistry,
+      terminalEnvironment.close,
+      {
+        environmentId: target.environmentId,
+        input: { threadId: target.threadId, terminalId: target.terminalId, deleteHistory: true },
+      },
+      { label: "terminal close", reportFailure: false },
+    );
+    if (result._tag === "Success") store.forgetRemoteClose(target);
+  } finally {
+    inFlight.delete(key);
+  }
+}
+
+export function closeRemoteTerminalTab(
+  threadRef: ScopedThreadRef,
+  environmentId: EnvironmentId,
+  terminalId: string,
+): void {
+  void closeRemoteTerminalSession({ environmentId, threadId: threadRef.threadId, terminalId });
+  // A tab left behind would reopen the shell on that machine when the thread is viewed.
+  useTerminalUiStateStore.getState().closeTerminal(threadRef, terminalId);
+}
+
+// The thread's server closes its own terminals on archive and delete. Terminals this client
+// opened for the thread on other machines never hear of it, so close them here.
+export function closeThreadRemoteTerminals(threadRef: ScopedThreadRef): void {
+  const remoteTerminals = selectThreadRemoteTerminals(
+    useTerminalUiStateStore.getState().remoteTerminalsByThreadKey,
+    threadRef,
+  );
+  for (const [terminalId, remote] of Object.entries(remoteTerminals)) {
+    closeRemoteTerminalTab(threadRef, remote.environmentId, terminalId);
+  }
+}
