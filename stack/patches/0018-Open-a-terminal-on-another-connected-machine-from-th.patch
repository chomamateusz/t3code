+const state = vi.hoisted(() => ({ canOperate: false, closeFails: false, closes: 0 }));
+
+vi.mock("../../rpc/atomRegistry", () => ({ appAtomRegistry: {} }));
+vi.mock("../../state/terminal", () => ({ terminalEnvironment: { close: {} } }));
