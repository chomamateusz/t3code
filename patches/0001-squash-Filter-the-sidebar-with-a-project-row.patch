+  const project = (name: string, pinned: boolean) =>
+    ({
+      id: name,
+      environmentId: "local",
+      title: name,
+      workspaceRoot: `/projects/${name}`,
+      projectKey: name,
+      displayName: name,
+      pinned,
+      archived: false,
+      updatedAt: "2026-11-01T00:00:00.000Z",
+      memberProjects: [
+        { physicalProjectKey: `local:/projects/${name}`, workspaceRoot: `/projects/${name}` },
